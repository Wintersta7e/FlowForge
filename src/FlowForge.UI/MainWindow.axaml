<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FlowForge.UI.ViewModels"
        xmlns:views="using:FlowForge.UI.Views"
        mc:Ignorable="d"
        d:DesignWidth="1400" d:DesignHeight="820"
        x:Class="FlowForge.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1400" Height="820"
        MinWidth="900" MinHeight="560"
        Icon="avares://FlowForge.UI/Assets/icon.png"
        FontFamily="{DynamicResource MwBody}"
        FontSize="13"
        Background="{DynamicResource MwInk}"
        KeyDown="OnKeyDown">

    <Grid RowDefinitions="Auto,*,Auto,160">
        <!-- Toolbar (row 0) -->
        <views:ToolbarView Grid.Row="0"
                           DataContext="{Binding}" />

        <!-- Main content area (row 1) -->
        <DockPanel Grid.Row="1">
            <!-- Operations library (left) -->
            <views:NodeLibraryView DockPanel.Dock="Left"
                                   Width="240"
                                   DataContext="{Binding NodeLibrary}" />

            <!-- Inspector (right) -->
            <views:PropertiesView DockPanel.Dock="Right"
                                  Width="300"
                                  DataContext="{Binding Properties}" />

            <!-- Canvas (center fill) -->
            <views:CanvasView DataContext="{Binding Editor}" />
        </DockPanel>

        <!-- GridSplitter (row 2) -->
        <GridSplitter Grid.Row="2"
                      Height="4"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource MwIronDark}"
                      ResizeDirection="Rows" />

        <!-- Output panel (row 3) -->
        <views:ExecutionLogView Grid.Row="3"
                                MinHeight="28"
                                MaxHeight="400"
                                DataContext="{Binding ExecutionLog}" />
    </Grid>
</Window>
