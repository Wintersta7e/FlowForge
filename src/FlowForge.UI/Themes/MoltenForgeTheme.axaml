<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>

            <!-- ═══ Typography tokens (theme-invariant) ═══ -->
            <!-- Embedded fonts: Instrument Serif, Oswald, JetBrains Mono -->
            <!-- MwSerif defaults to Italic because every serif use in this design is italic -->
            <FontFamily x:Key="MwSerif">avares://FlowForge.UI/Assets/Fonts/InstrumentSerif-Italic.ttf#Instrument Serif</FontFamily>
            <FontFamily x:Key="MwSerifRegular">avares://FlowForge.UI/Assets/Fonts/InstrumentSerif-Regular.ttf#Instrument Serif</FontFamily>
            <FontFamily x:Key="MwDisplay">avares://FlowForge.UI/Assets/Fonts/Oswald-VariableFont_wght.ttf#Oswald</FontFamily>
            <FontFamily x:Key="MwMono">avares://FlowForge.UI/Assets/Fonts/JetBrainsMono-VariableFont_wght.ttf#JetBrains Mono</FontFamily>
            <FontFamily x:Key="MwBody">Inter, Segoe UI, system-ui, sans-serif</FontFamily>

            <ResourceDictionary.ThemeDictionaries>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ═══ DARK VARIANT (Molten Works) ═══════════ -->
                <!-- ═══════════════════════════════════════════ -->
                <ResourceDictionary x:Key="Dark">

                    <!-- ═══ Molten Works palette (mwT) ═══ -->
                    <Color x:Key="MwInkColor">#08060a</Color>
                    <Color x:Key="MwBgColor">#0f0a08</Color>
                    <Color x:Key="MwBgDeepColor">#05030a</Color>
                    <Color x:Key="MwPanelColor">#14100c</Color>
                    <Color x:Key="MwPanelHiColor">#1c1510</Color>
                    <Color x:Key="MwIronColor">#4a3d35</Color>
                    <Color x:Key="MwIronDarkColor">#2a2018</Color>
                    <Color x:Key="MwIronLiteColor">#7a6a5c</Color>

                    <Color x:Key="MwChromeColor">#b8b8c4</Color>
                    <Color x:Key="MwChromeDkColor">#4a4a58</Color>
                    <Color x:Key="MwChromeHiColor">#e4e4ec</Color>

                    <Color x:Key="MwBoneColor">#ecdfc8</Color>
                    <Color x:Key="MwAshColor">#9a8c7a</Color>
                    <Color x:Key="MwFaintColor">#5a4e42</Color>

                    <Color x:Key="MwMoltenColor">#ff7a1a</Color>
                    <Color x:Key="MwMoltenHiColor">#ffd080</Color>
                    <Color x:Key="MwMoltenLoColor">#c44010</Color>

                    <Color x:Key="MwMercuryColor">#d8dde8</Color>
                    <Color x:Key="MwCyanColor">#2ef0ff</Color>
                    <Color x:Key="MwMagColor">#ff2e88</Color>
                    <Color x:Key="MwLimeColor">#c3ff3e</Color>
                    <Color x:Key="MwPurpleColor">#b23eff</Color>

                    <!-- Category glows (for drop-shadow under stations) -->
                    <Color x:Key="MwSrcGlowColor">#ffd080</Color>
                    <Color x:Key="MwSnkGlowColor">#b5f0ff</Color>
                    <Color x:Key="MwShpGlowColor">#ff2e88</Color>
                    <Color x:Key="MwFltGlowColor">#c3ff3e</Color>
                    <Color x:Key="MwHeaGlowColor">#ff7a1a</Color>
                    <Color x:Key="MwMetGlowColor">#b23eff</Color>

                    <!-- Category icon-well base colors (inside the station) -->
                    <Color x:Key="MwSrcBaseColor">#3a2515</Color>
                    <Color x:Key="MwSnkBaseColor">#102630</Color>
                    <Color x:Key="MwShpBaseColor">#2a0818</Color>
                    <Color x:Key="MwFltBaseColor">#1a2608</Color>
                    <Color x:Key="MwHeaBaseColor">#3a1808</Color>
                    <Color x:Key="MwMetBaseColor">#200838</Color>

                    <!-- ═══ Back-compat: remap Forge* to Molten Works values ═══ -->
                    <Color x:Key="ForgeBgColor">#08060a</Color>
                    <Color x:Key="ForgeDeepColor">#05030a</Color>
                    <Color x:Key="ForgePanelColor">#14100c</Color>
                    <Color x:Key="ForgeSurfaceColor">#14100c</Color>
                    <Color x:Key="ForgeElevatedColor">#1c1510</Color>
                    <Color x:Key="ForgeHoverColor">#2a2018</Color>
                    <Color x:Key="ForgeBorderColor">#2a2018</Color>
                    <Color x:Key="ForgeBorderFocusColor">#4a3d35</Color>
                    <Color x:Key="ForgeTextColor">#ecdfc8</Color>
                    <Color x:Key="ForgeTextSecondaryColor">#9a8c7a</Color>
                    <Color x:Key="ForgeTextMutedColor">#5a4e42</Color>
                    <Color x:Key="ForgeAccentColor">#ff7a1a</Color>
                    <Color x:Key="ForgeAccentBrightColor">#ffd080</Color>
                    <!-- Category remap: Source=molten, Transform=lime (generic), Output=cyan -->
                    <Color x:Key="ForgeSourceColor">#ff7a1a</Color>
                    <Color x:Key="ForgeTransformColor">#c3ff3e</Color>
                    <Color x:Key="ForgeOutputColor">#2ef0ff</Color>
                    <Color x:Key="ForgeSuccessColor">#c3ff3e</Color>
                    <Color x:Key="ForgeErrorColor">#ff2e88</Color>
                    <Color x:Key="ForgeWarningColor">#ffd080</Color>
                    <Color x:Key="ForgeMoltenFromColor">#c44010</Color>
                    <Color x:Key="ForgeMoltenToColor">#ffd080</Color>

                    <!-- ═══ Brush Resources — Molten Works ═══ -->
                    <SolidColorBrush x:Key="MwInk" Color="{StaticResource MwInkColor}" />
                    <SolidColorBrush x:Key="MwBg" Color="{StaticResource MwBgColor}" />
                    <SolidColorBrush x:Key="MwBgDeep" Color="{StaticResource MwBgDeepColor}" />
                    <SolidColorBrush x:Key="MwPanel" Color="{StaticResource MwPanelColor}" />
                    <SolidColorBrush x:Key="MwPanelHi" Color="{StaticResource MwPanelHiColor}" />
                    <SolidColorBrush x:Key="MwIron" Color="{StaticResource MwIronColor}" />
                    <SolidColorBrush x:Key="MwIronDark" Color="{StaticResource MwIronDarkColor}" />
                    <SolidColorBrush x:Key="MwIronLite" Color="{StaticResource MwIronLiteColor}" />
                    <SolidColorBrush x:Key="MwChrome" Color="{StaticResource MwChromeColor}" />
                    <SolidColorBrush x:Key="MwChromeDk" Color="{StaticResource MwChromeDkColor}" />
                    <SolidColorBrush x:Key="MwChromeHi" Color="{StaticResource MwChromeHiColor}" />
                    <SolidColorBrush x:Key="MwBone" Color="{StaticResource MwBoneColor}" />
                    <SolidColorBrush x:Key="MwAsh" Color="{StaticResource MwAshColor}" />
                    <SolidColorBrush x:Key="MwFaint" Color="{StaticResource MwFaintColor}" />
                    <SolidColorBrush x:Key="MwMolten" Color="{StaticResource MwMoltenColor}" />
                    <SolidColorBrush x:Key="MwMoltenHi" Color="{StaticResource MwMoltenHiColor}" />
                    <SolidColorBrush x:Key="MwMoltenLo" Color="{StaticResource MwMoltenLoColor}" />
                    <SolidColorBrush x:Key="MwMercury" Color="{StaticResource MwMercuryColor}" />
                    <SolidColorBrush x:Key="MwCyan" Color="{StaticResource MwCyanColor}" />
                    <SolidColorBrush x:Key="MwMag" Color="{StaticResource MwMagColor}" />
                    <SolidColorBrush x:Key="MwLime" Color="{StaticResource MwLimeColor}" />
                    <SolidColorBrush x:Key="MwPurple" Color="{StaticResource MwPurpleColor}" />

                    <!-- Semi-transparent utilities -->
                    <SolidColorBrush x:Key="MwInkA45" Color="#73000000" />
                    <SolidColorBrush x:Key="MwInkA30" Color="#4D000000" />
                    <SolidColorBrush x:Key="MwInkA85" Color="#D9000000" />

                    <!-- Station iron vertical gradient -->
                    <LinearGradientBrush x:Key="MwIronBody" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="{StaticResource MwIronColor}" />
                        <GradientStop Offset="0.45" Color="{StaticResource MwIronDarkColor}" />
                        <GradientStop Offset="1" Color="#0d0805" />
                    </LinearGradientBrush>

                    <!-- Panel vertical gradient (library + inspector) -->
                    <LinearGradientBrush x:Key="MwPanelBody" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="{StaticResource MwPanelColor}" />
                        <GradientStop Offset="1" Color="{StaticResource MwBgDeepColor}" />
                    </LinearGradientBrush>

                    <!-- Top bar gradient -->
                    <LinearGradientBrush x:Key="MwTopBarBody" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="{StaticResource MwPanelColor}" />
                        <GradientStop Offset="1" Color="{StaticResource MwBgDeepColor}" />
                    </LinearGradientBrush>

                    <!-- Bottom console gradient -->
                    <LinearGradientBrush x:Key="MwConsoleBody" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="{StaticResource MwBgDeepColor}" />
                        <GradientStop Offset="1" Color="#020106" />
                    </LinearGradientBrush>

                    <!-- Molten IGNITE button gradient -->
                    <LinearGradientBrush x:Key="MwMoltenButton" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="{StaticResource MwMoltenHiColor}" />
                        <GradientStop Offset="0.5" Color="{StaticResource MwMoltenColor}" />
                        <GradientStop Offset="1" Color="{StaticResource MwMoltenLoColor}" />
                    </LinearGradientBrush>

                    <!-- Progress bar molten fill (horizontal) -->
                    <LinearGradientBrush x:Key="MwProgressFill" StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0" Color="{StaticResource MwMoltenLoColor}" />
                        <GradientStop Offset="0.5" Color="{StaticResource MwMoltenColor}" />
                        <GradientStop Offset="1" Color="{StaticResource MwMoltenHiColor}" />
                    </LinearGradientBrush>

                    <!-- Pipe liquid horizontal gradient (for running pipes) -->
                    <LinearGradientBrush x:Key="MwPipeLiquid" StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Offset="0" Color="{StaticResource MwMoltenLoColor}" />
                        <GradientStop Offset="0.5" Color="{StaticResource MwMoltenColor}" />
                        <GradientStop Offset="1" Color="{StaticResource MwMoltenHiColor}" />
                    </LinearGradientBrush>

                    <!-- Category brushes (Mw) -->
                    <SolidColorBrush x:Key="MwSrc" Color="{StaticResource MwMoltenColor}" />
                    <SolidColorBrush x:Key="MwSnk" Color="{StaticResource MwCyanColor}" />
                    <SolidColorBrush x:Key="MwShp" Color="{StaticResource MwMagColor}" />
                    <SolidColorBrush x:Key="MwFlt" Color="{StaticResource MwLimeColor}" />
                    <SolidColorBrush x:Key="MwHea" Color="{StaticResource MwMoltenColor}" />
                    <SolidColorBrush x:Key="MwMet" Color="{StaticResource MwPurpleColor}" />

                    <SolidColorBrush x:Key="MwSrcGlow" Color="{StaticResource MwSrcGlowColor}" />
                    <SolidColorBrush x:Key="MwSnkGlow" Color="{StaticResource MwSnkGlowColor}" />
                    <SolidColorBrush x:Key="MwShpGlow" Color="{StaticResource MwShpGlowColor}" />
                    <SolidColorBrush x:Key="MwFltGlow" Color="{StaticResource MwFltGlowColor}" />
                    <SolidColorBrush x:Key="MwHeaGlow" Color="{StaticResource MwHeaGlowColor}" />
                    <SolidColorBrush x:Key="MwMetGlow" Color="{StaticResource MwMetGlowColor}" />

                    <SolidColorBrush x:Key="MwSrcBase" Color="{StaticResource MwSrcBaseColor}" />
                    <SolidColorBrush x:Key="MwSnkBase" Color="{StaticResource MwSnkBaseColor}" />
                    <SolidColorBrush x:Key="MwShpBase" Color="{StaticResource MwShpBaseColor}" />
                    <SolidColorBrush x:Key="MwFltBase" Color="{StaticResource MwFltBaseColor}" />
                    <SolidColorBrush x:Key="MwHeaBase" Color="{StaticResource MwHeaBaseColor}" />
                    <SolidColorBrush x:Key="MwMetBase" Color="{StaticResource MwMetBaseColor}" />

                    <!-- ═══ Back-compat Forge* brush aliases ═══ -->
                    <SolidColorBrush x:Key="ForgeBg" Color="{StaticResource ForgeBgColor}" />
                    <SolidColorBrush x:Key="ForgeDeep" Color="{StaticResource ForgeDeepColor}" />
                    <SolidColorBrush x:Key="ForgePanel" Color="{StaticResource ForgePanelColor}" />
                    <SolidColorBrush x:Key="ForgeSurface" Color="{StaticResource ForgeSurfaceColor}" />
                    <SolidColorBrush x:Key="ForgeElevated" Color="{StaticResource ForgeElevatedColor}" />
                    <SolidColorBrush x:Key="ForgeHover" Color="{StaticResource ForgeHoverColor}" />
                    <SolidColorBrush x:Key="ForgeBorder" Color="{StaticResource ForgeBorderColor}" />
                    <SolidColorBrush x:Key="ForgeBorderFocus" Color="{StaticResource ForgeBorderFocusColor}" />
                    <SolidColorBrush x:Key="ForgeText" Color="{StaticResource ForgeTextColor}" />
                    <SolidColorBrush x:Key="ForgeTextSecondary" Color="{StaticResource ForgeTextSecondaryColor}" />
                    <SolidColorBrush x:Key="ForgeTextMuted" Color="{StaticResource ForgeTextMutedColor}" />
                    <SolidColorBrush x:Key="ForgeAccent" Color="{StaticResource ForgeAccentColor}" />
                    <SolidColorBrush x:Key="ForgeAccentBright" Color="{StaticResource ForgeAccentBrightColor}" />
                    <SolidColorBrush x:Key="ForgeSource" Color="{StaticResource ForgeSourceColor}" />
                    <SolidColorBrush x:Key="ForgeTransform" Color="{StaticResource ForgeTransformColor}" />
                    <SolidColorBrush x:Key="ForgeOutput" Color="{StaticResource ForgeOutputColor}" />
                    <SolidColorBrush x:Key="ForgeSuccess" Color="{StaticResource ForgeSuccessColor}" />
                    <SolidColorBrush x:Key="ForgeError" Color="{StaticResource ForgeErrorColor}" />
                    <SolidColorBrush x:Key="ForgeWarning" Color="{StaticResource ForgeWarningColor}" />
                    <SolidColorBrush x:Key="ForgeMoltenFrom" Color="{StaticResource ForgeMoltenFromColor}" />
                    <SolidColorBrush x:Key="ForgeMoltenTo" Color="{StaticResource ForgeMoltenToColor}" />
                    <SolidColorBrush x:Key="ForgeSourceDim" Color="#26ff7a1a" />
                    <SolidColorBrush x:Key="ForgeTransformDim" Color="#26c3ff3e" />
                    <SolidColorBrush x:Key="ForgeOutputDim" Color="#262ef0ff" />
                    <SolidColorBrush x:Key="ForgeSuccessDim" Color="#26c3ff3e" />
                    <SolidColorBrush x:Key="ForgeErrorDim" Color="#26ff2e88" />
                    <SolidColorBrush x:Key="ForgeWarningDim" Color="#26ffd080" />

                </ResourceDictionary>


            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ═══ Global Style Overrides ═══ -->

    <!-- Button: forge surface bg, border, rounded 2px (squared cast-iron feel) -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource MwPanel}" />
        <Setter Property="Foreground" Value="{DynamicResource MwBone}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MwIronDark}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MwPanelHi}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MwIronDark}" />
    </Style>

    <!-- Button.accent == IGNITE: molten gradient, dark text, glow -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource MwMoltenButton}" />
        <Setter Property="Foreground" Value="#1a0a04" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource MwDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MwMoltenHi}" />
    </Style>

    <!-- Button.quench: active-running state, cyan outline, dark fill -->
    <Style Selector="Button.quench">
        <Setter Property="Background" Value="{DynamicResource MwBgDeep}" />
        <Setter Property="Foreground" Value="{DynamicResource MwCyan}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MwCyan}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource MwDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,6" />
    </Style>

    <!-- Button.ghost: transparent ash outline (DRY RUN, etc) -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MwAsh}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MwIronDark}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource MwDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MwPanelHi}" />
    </Style>

    <!-- Button.preview: back-compat alias of ghost -->
    <Style Selector="Button.preview">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource MwMolten}" />
        <Setter Property="Foreground" Value="{DynamicResource MwMolten}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Button.toolbarIcon -->
    <Style Selector="Button.toolbarIcon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="Button.toolbarIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MwPanelHi}" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <!-- Button.templateButton: quick-start template cards (cast iron) -->
    <Style Selector="Button.templateButton">
        <Setter Property="Background" Value="{DynamicResource MwIronBody}" />
        <Setter Property="Foreground" Value="{DynamicResource MwBone}" />
        <Setter Property="BorderBrush" Value="#050303" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.templateButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MwPanelHi}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MwMolten}" />
    </Style>

    <!-- TextBox: forge ink bg with category neon left border (Mw aesthetic) -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource MwInkA45}" />
        <Setter Property="Foreground" Value="{DynamicResource MwBone}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MwIronDark}" />
        <Setter Property="BorderThickness" Value="2,1,1,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource MwMono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CaretBrush" Value="{DynamicResource MwMolten}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource MwMolten}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource MwInkA45}" />
        <Setter Property="Foreground" Value="{DynamicResource MwBone}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MwIronDark}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource MwMono}" />
    </Style>

    <Style Selector="ToggleSwitch">
        <Setter Property="Foreground" Value="{DynamicResource MwBone}" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource MwBone}" />
    </Style>

    <Style Selector="TreeView">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource MwBone}" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource MwIronDark}" />
        <Setter Property="Foreground" Value="{DynamicResource MwProgressFill}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Expander">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MwBone}" />
    </Style>

    <!-- ToggleButton.outputTab: flat tab button for output panel -->
    <Style Selector="ToggleButton.outputTab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MwAsh}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{DynamicResource MwMono}" />
    </Style>
    <Style Selector="ToggleButton.outputTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MwPanel}" />
    </Style>
    <Style Selector="ToggleButton.outputTab:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MwBgDeep}" />
    </Style>
    <Style Selector="ToggleButton.outputTab:checked">
        <Setter Property="Foreground" Value="{DynamicResource MwBone}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MwMolten}" />
    </Style>

</Styles>
