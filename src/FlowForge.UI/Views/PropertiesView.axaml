<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FlowForge.UI.ViewModels"
             xmlns:views="using:FlowForge.UI.Views"
             mc:Ignorable="d"
             d:DesignWidth="300" d:DesignHeight="720"
             x:Class="FlowForge.UI.Views.PropertiesView"
             x:DataType="vm:PropertiesViewModel">

    <Border Background="{DynamicResource MwPanelBody}"
            BorderBrush="{DynamicResource MwIronDark}"
            BorderThickness="1,0,0,0">
        <DockPanel LastChildFill="True">

            <!-- Header: // inspector eyebrow + selected node title -->
            <StackPanel DockPanel.Dock="Top"
                        Margin="22,18,22,0"
                        Spacing="10">
                <TextBlock Text="// INSPECTOR"
                           FontFamily="{DynamicResource MwMono}"
                           FontSize="9"
                           LetterSpacing="3"
                           Foreground="{DynamicResource MwCyan}" />

                <!-- Selected node header row (icon well + title + code · sub) -->
                <Border IsVisible="{Binding HasSelection}"
                        BorderBrush="{DynamicResource MwIronDark}"
                        BorderThickness="0,0,0,1"
                        Padding="0,4,0,14">
                    <Grid ColumnDefinitions="44,12,*">
                        <Border Grid.Column="0"
                                Width="44" Height="44"
                                CornerRadius="3"
                                BorderThickness="1"
                                BorderBrush="{Binding MwNeonBrush}"
                                BoxShadow="0 0 20 0 #66FFD080">
                            <Border.Background>
                                <RadialGradientBrush Center="0.3,0.2" GradientOrigin="0.3,0.2" RadiusX="0.9" RadiusY="0.9">
                                    <GradientStop Offset="0" Color="#3a1808" />
                                    <GradientStop Offset="1" Color="#0a0503" />
                                </RadialGradientBrush>
                            </Border.Background>
                            <Viewbox Width="26" Height="26">
                                <Path Data="{Binding MwIconGeometry}"
                                      Stroke="{Binding MwNeonBrush}"
                                      StrokeThickness="1.7"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Width="40" Height="40" />
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="2"
                                    Orientation="Vertical"
                                    Spacing="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedNodeTitle}"
                                       FontFamily="{DynamicResource MwSerif}"
                                       FontSize="26"
                                       LineHeight="26"
                                       Foreground="{DynamicResource MwBone}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding MwCode}"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="9"
                                           LetterSpacing="1.5"
                                           Foreground="{Binding MwNeonBrush}" />
                                <TextBlock Text="·"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="9"
                                           Foreground="{Binding MwNeonBrush}" />
                                <TextBlock Text="{Binding MwSub}"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="9"
                                           LetterSpacing="1.5"
                                           Foreground="{Binding MwNeonBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Body: fields when selected, empty-state prompt otherwise. -->
            <!-- Wrapped in a Grid so both can overlay without the empty-state
                 StackPanel being default-docked Left (which squished it to a
                 narrow column and made the panel look broken). -->
            <Grid>
                <!-- Empty state: centered serif prompt -->
                <StackPanel IsVisible="{Binding !HasSelection}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="4"
                            Margin="24">
                    <TextBlock Text="Select a station to"
                               FontFamily="{DynamicResource MwSerif}"
                               FontSize="16"
                               LineHeight="24"
                               Foreground="{DynamicResource MwFaint}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="tune its settings."
                               FontFamily="{DynamicResource MwSerif}"
                               FontSize="16"
                               LineHeight="24"
                               Foreground="{DynamicResource MwFaint}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Fields list (unchanged — uses existing ConfigFieldTemplateSelector) -->
                <ScrollViewer IsVisible="{Binding HasSelection}"
                              Padding="16,8,16,18">
                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemTemplate>
                            <views:ConfigFieldTemplateSelector />
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
