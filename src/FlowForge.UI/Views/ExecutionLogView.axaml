<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FlowForge.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="200"
             x:Class="FlowForge.UI.Views.ExecutionLogView"
             x:DataType="vm:ExecutionLogViewModel">

    <DockPanel Background="{DynamicResource MwPanel}">

        <!-- ═══ Mw Console strip (52px) — status / PID / progress / throughput ═══ -->
        <Border DockPanel.Dock="Top"
                Height="52"
                Background="{DynamicResource MwConsoleBody}"
                BorderBrush="{DynamicResource MwIronDark}"
                BorderThickness="0,1,0,1"
                Padding="20,0">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">

                <!-- Status pill: dot + Cold / Forge Lit -->
                <StackPanel Grid.Column="0"
                            AutomationProperties.AutomationId="ConsoleState"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7"
                             VerticalAlignment="Center"
                             IsVisible="{Binding IsRunning}"
                             Fill="{DynamicResource MwMolten}">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#FF7A1A" Opacity="1" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Width="7" Height="7"
                             VerticalAlignment="Center"
                             IsVisible="{Binding !IsRunning}"
                             Fill="{DynamicResource MwIron}" />
                    <TextBlock Text="FORGE LIT"
                               IsVisible="{Binding IsRunning}"
                               FontFamily="{DynamicResource MwDisplay}"
                               FontSize="11" FontWeight="SemiBold"
                               LetterSpacing="2.2"
                               Foreground="{DynamicResource MwMoltenHi}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="COLD"
                               FontFamily="{DynamicResource MwDisplay}"
                               FontSize="11" FontWeight="SemiBold"
                               LetterSpacing="2.2"
                               Foreground="{DynamicResource MwIronLite}"
                               VerticalAlignment="Center">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!IsRunning" />
                                <Binding Path="!IsDemo" />
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>
                    <TextBlock Text="DEMO"
                               FontFamily="{DynamicResource MwDisplay}"
                               FontSize="11" FontWeight="SemiBold"
                               LetterSpacing="2.2"
                               Foreground="{DynamicResource MwCyan}"
                               VerticalAlignment="Center">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsDemo" />
                                <Binding Path="!IsRunning" />
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="1" Height="20"
                        Background="{DynamicResource MwIronDark}"
                        VerticalAlignment="Center"
                        Margin="16,0" />

                <!-- PID (hidden in the demo: no run, so no process to name) -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="!IsDemo" />
                            <Binding Path="IsRunning" />
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <TextBlock Text="pid/"
                               FontFamily="{DynamicResource MwMono}"
                               FontSize="10"
                               LetterSpacing="0.9"
                               Foreground="{DynamicResource MwFaint}" />
                    <TextBlock Text="{Binding ProcessIdHex}"
                               AutomationProperties.AutomationId="ConsolePid"
                               Classes.running="{Binding IsRunning}"
                               FontFamily="{DynamicResource MwMono}"
                               FontSize="10"
                               LetterSpacing="0.9">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource MwFaint}" />
                            </Style>
                            <Style Selector="TextBlock.running">
                                <Setter Property="Foreground" Value="{DynamicResource MwCyan}" />
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                </StackPanel>

                <Border Grid.Column="3"
                        Width="1" Height="20"
                        Background="{DynamicResource MwIronDark}"
                        VerticalAlignment="Center"
                        Margin="16,0"
                        IsVisible="{Binding IsRunning}" />

                <!-- Running: count + progress bar + throughput -->
                <Grid Grid.Column="4"
                      IsVisible="{Binding IsRunning}"
                      ColumnDefinitions="Auto,*,Auto"
                      VerticalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               AutomationProperties.AutomationId="ConsoleCount"
                               Text="{Binding ProgressText}"
                               FontFamily="{DynamicResource MwMono}"
                               FontSize="11"
                               Foreground="{DynamicResource MwBone}"
                               MinWidth="100"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Border Grid.Column="1"
                            Height="5"
                            Background="{DynamicResource MwIronDark}"
                            VerticalAlignment="Center">
                        <Grid>
                            <!-- Molten fill -->
                            <ProgressBar Value="{Binding Progress}"
                                         Minimum="0" Maximum="100"
                                         IsIndeterminate="{Binding IsIndeterminate}"
                                         Height="5"
                                         Background="Transparent"
                                         Foreground="{DynamicResource MwProgressFill}"
                                         BorderThickness="0"
                                         CornerRadius="0" />
                            <!-- Diagonal stripe overlay -->
                            <Border IsHitTestVisible="False" Opacity="0.4">
                                <Border.Background>
                                    <DrawingBrush TileMode="Tile"
                                                  DestinationRect="0,0,9,5"
                                                  SourceRect="0,0,9,5">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="#4D000000"
                                                             Geometry="M 0,0 L 1,0 L 1,5 L 0,5 Z" />
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="2"
                               AutomationProperties.AutomationId="ConsoleThroughput"
                               Text="{Binding ThroughputRate}"
                               FontFamily="{DynamicResource MwMono}"
                               FontSize="11"
                               Foreground="{DynamicResource MwMoltenHi}"
                               MinWidth="76"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </Grid>

                <!-- Idle caption -->
                <TextBlock Grid.Column="4"
                           AutomationProperties.AutomationId="ConsoleIdleCaption"
                           Text="// awaiting ignition signal"
                           FontFamily="{DynamicResource MwMono}"
                           FontSize="10"
                           LetterSpacing="0.5"
                           Foreground="{DynamicResource MwFaint}"
                           VerticalAlignment="Center">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsRunning" />
                            <Binding Path="!IsDemo" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
                <TextBlock Grid.Column="4"
                           AutomationProperties.AutomationId="ConsoleDemoCaption"
                           Text="// demo — no files touched"
                           FontFamily="{DynamicResource MwMono}"
                           FontSize="10"
                           LetterSpacing="0.5"
                           Foreground="{DynamicResource MwFaint}"
                           VerticalAlignment="Center">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsDemo" />
                            <Binding Path="!IsRunning" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>

                <!-- Right: flavor quote when running -->
                <TextBlock Grid.Column="5"
                           IsVisible="{Binding IsRunning}"
                           Text="&quot;The iron sings.&quot;"
                           FontFamily="{DynamicResource MwSerif}"
                           FontStyle="Italic"
                           FontSize="13"
                           Foreground="{DynamicResource MwAsh}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0" />
            </Grid>
        </Border>

        <!-- Molten accent line (kept) -->
        <Border DockPanel.Dock="Top" Height="2" Opacity="0.5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Color="Transparent" Offset="0" />
                    <GradientStop Color="#d4612c" Offset="0.2" />
                    <GradientStop Color="#f5a623" Offset="0.5" />
                    <GradientStop Color="#f5c842" Offset="0.8" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Tab strip -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource ForgeBorder}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <!-- Output tab -->
                <ToggleButton Grid.Column="0"
                              Classes="outputTab"
                              IsChecked="{Binding IsOutputTabSelected, Mode=OneWay}"
                              Command="{Binding SelectTabCommand}"
                              CommandParameter="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Output" VerticalAlignment="Center" FontSize="12" />
                        <Border Background="#265ce0a0" CornerRadius="8" Padding="6,1"
                                IsVisible="{Binding !!TotalFiles}">
                            <TextBlock Text="{Binding Succeeded}"
                                       AutomationProperties.AutomationId="SucceededCount"
                                       Foreground="{DynamicResource ForgeSuccess}"
                                       FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </ToggleButton>

                <!-- Errors tab -->
                <ToggleButton Grid.Column="1"
                              Classes="outputTab"
                              IsChecked="{Binding IsErrorsTabSelected, Mode=OneWay}"
                              Command="{Binding SelectTabCommand}"
                              CommandParameter="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Errors" VerticalAlignment="Center" FontSize="12" />
                        <Border Background="#26f2716a" CornerRadius="8" Padding="6,1"
                                IsVisible="{Binding !!Failed}">
                            <TextBlock Text="{Binding Failed}"
                                       AutomationProperties.AutomationId="FailedCount"
                                       Foreground="{DynamicResource ForgeError}"
                                       FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </ToggleButton>

                <!-- Skipped tab -->
                <ToggleButton Grid.Column="2"
                              Classes="outputTab"
                              IsChecked="{Binding IsWarningsTabSelected, Mode=OneWay}"
                              Command="{Binding SelectTabCommand}"
                              CommandParameter="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Skipped" VerticalAlignment="Center" FontSize="12" />
                        <Border Background="#26f5c842" CornerRadius="8" Padding="6,1"
                                IsVisible="{Binding !!Skipped}">
                            <TextBlock Text="{Binding Skipped}"
                                       AutomationProperties.AutomationId="SkippedCount"
                                       Foreground="{DynamicResource ForgeWarning}"
                                       FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </ToggleButton>

                <!-- Summary text (right-aligned, when not running) -->
                <TextBlock Grid.Column="4"
                           AutomationProperties.AutomationId="RunSummary"
                           Text="{Binding Summary}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource ForgeTextSecondary}"
                           FontSize="12"
                           Margin="8,0,12,0"
                           IsVisible="{Binding !IsRunning}" />
            </Grid>
        </Border>

        <!-- Phase strip (docked below tab strip, visible when running); the console holds the progress bar -->
        <Border DockPanel.Dock="Top"
                Padding="12,6"
                BorderBrush="{DynamicResource ForgeBorder}"
                BorderThickness="0,0,0,1"
                IsVisible="{Binding IsRunning}">
            <TextBlock Text="{Binding PhaseLabel}"
                       AutomationProperties.AutomationId="PhaseLabel"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource ForgeTextSecondary}"
                       FontSize="12" />
        </Border>

        <!-- Content area (collapsible) -->
        <Panel IsVisible="{Binding IsPanelExpanded}">
            <!-- Output tab content -->
            <DockPanel IsVisible="{Binding IsOutputTabSelected}">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileJobLogEntryViewModel">
                                <Border Padding="12,3"
                                        BorderBrush="{DynamicResource ForgeBorder}"
                                        BorderThickness="0,0,0,1"
                                        ToolTip.Tip="{Binding NodeLogText}">
                                    <Grid ColumnDefinitions="Auto,8,55,Auto,*">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp}"
                                                   FontFamily="{DynamicResource MwMono}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ForgeTextMuted}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <Ellipse Grid.Column="1" Width="6" Height="6"
                                                 Fill="{DynamicResource ForgeSuccess}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding StatusText}"
                                                   FontFamily="{DynamicResource MwMono}"
                                                   FontWeight="Bold" FontSize="12"
                                                   Foreground="{DynamicResource ForgeSuccess}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding FileName}"
                                                   FontFamily="{DynamicResource MwMono}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ForgeText}"
                                                   FontSize="12"
                                                   Margin="0,0,8,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Errors tab content -->
            <Panel IsVisible="{Binding IsErrorsTabSelected}">
                <TextBlock Text="No errors"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ForgeTextMuted}"
                           FontSize="12"
                           IsVisible="{Binding !ErrorEntries.Count}" />

                <ScrollViewer IsVisible="{Binding !!ErrorEntries.Count}">
                    <ItemsControl ItemsSource="{Binding ErrorEntries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileJobLogEntryViewModel">
                                <Border Padding="12,3"
                                        BorderBrush="{DynamicResource ForgeBorder}"
                                        BorderThickness="0,0,0,1"
                                        ToolTip.Tip="{Binding NodeLogText}">
                                    <Grid ColumnDefinitions="Auto,8,55,Auto,*">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp}"
                                                   FontFamily="{DynamicResource MwMono}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ForgeTextMuted}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <Ellipse Grid.Column="1" Width="6" Height="6"
                                                 Fill="{DynamicResource ForgeError}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding StatusText}"
                                                   FontFamily="{DynamicResource MwMono}"
                                                   FontWeight="Bold" FontSize="12"
                                                   Foreground="{DynamicResource ForgeError}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding FileName}"
                                                   FontFamily="{DynamicResource MwMono}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ForgeText}"
                                                   FontSize="12"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding ErrorMessage}"
                                                   FontFamily="{DynamicResource MwMono}"
                                                   Foreground="{DynamicResource ForgeError}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>

            <!-- Skipped tab content -->
            <Panel IsVisible="{Binding IsWarningsTabSelected}">
                <TextBlock Text="No skipped files"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ForgeTextMuted}"
                           FontSize="12"
                           IsVisible="{Binding !WarningEntries.Count}" />

                <ScrollViewer IsVisible="{Binding !!WarningEntries.Count}">
                    <ItemsControl ItemsSource="{Binding WarningEntries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileJobLogEntryViewModel">
                                <Border Padding="12,3"
                                        BorderBrush="{DynamicResource ForgeBorder}"
                                        BorderThickness="0,0,0,1"
                                        ToolTip.Tip="{Binding NodeLogText}">
                                    <Grid ColumnDefinitions="Auto,8,55,Auto,*">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp}"
                                                   FontFamily="{DynamicResource MwMono}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ForgeTextMuted}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <Ellipse Grid.Column="1" Width="6" Height="6"
                                                 Fill="{DynamicResource ForgeWarning}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding StatusText}"
                                                   FontFamily="{DynamicResource MwMono}"
                                                   FontWeight="Bold" FontSize="12"
                                                   Foreground="{DynamicResource ForgeWarning}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding FileName}"
                                                   FontFamily="{DynamicResource MwMono}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ForgeText}"
                                                   FontSize="12"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding ErrorMessage}"
                                                   FontFamily="{DynamicResource MwMono}"
                                                   Foreground="{DynamicResource ForgeWarning}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </Panel>
    </DockPanel>
</UserControl>
