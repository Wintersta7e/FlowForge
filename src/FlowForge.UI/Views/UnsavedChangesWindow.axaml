<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlowForge.UI.Views.UnsavedChangesWindow"
        x:DataType="x:String"
        Title="Unsaved changes"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ForgePanel}">

    <!-- DataContext: the pipeline's file name. -->
    <StackPanel Margin="24" Spacing="20">
        <TextBlock Text="{Binding StringFormat='“{0}” has unsaved changes. Save them first?'}"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{DynamicResource ForgeText}" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Content="Save"
                    Classes="accent"
                    Padding="16,6"
                    Click="OnSaveClick" />
            <Button Content="Discard"
                    Classes="ghost"
                    Padding="16,6"
                    Click="OnDiscardClick" />
            <Button Content="Cancel"
                    Classes="ghost"
                    Padding="16,6"
                    IsCancel="True"
                    Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
