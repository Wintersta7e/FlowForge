<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FlowForge.UI.ViewModels"
             xmlns:nodify="using:Nodify.Avalonia"
             xmlns:nodifyConn="using:Nodify.Avalonia.Connections"
             xmlns:views="using:FlowForge.UI.Views"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="FlowForge.UI.Views.CanvasView"
             x:DataType="vm:EditorViewModel">

    <Grid>
        <!-- ═══ Canvas backdrop: forge ambience + cyberpunk grid ═══ -->
        <!-- Base gradient wash (ember-orange at bottom, cyan/mag accents) -->
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="0.5,1.1" GradientOrigin="0.5,1.1" RadiusX="0.9" RadiusY="0.5">
                    <GradientStop Offset="0" Color="#38FF5014" />
                    <GradientStop Offset="0.6" Color="Transparent" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="0.15,0.3" GradientOrigin="0.15,0.3" RadiusX="0.5" RadiusY="0.4">
                    <GradientStop Offset="0" Color="#152EF0FF" />
                    <GradientStop Offset="0.7" Color="Transparent" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="0.85,0.7" GradientOrigin="0.85,0.7" RadiusX="0.5" RadiusY="0.4">
                    <GradientStop Offset="0" Color="#10FF2E88" />
                    <GradientStop Offset="0.7" Color="Transparent" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <!-- Linear base tint behind it all -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#04020a" />
                    <GradientStop Offset="0.5" Color="#08060a" />
                    <GradientStop Offset="1" Color="#0f0a08" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ═══ HUD grid overlay: 40x40 minor + 200x200 major lines ═══ -->
        <Border IsHitTestVisible="False" Opacity="0.25">
            <Border.Background>
                <DrawingBrush TileMode="Tile"
                              DestinationRect="0,0,40,40"
                              SourceRect="0,0,40,40">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="#248C96C8"
                                             Geometry="M0,0 L40,0 L40,0.5 L0,0.5 Z M0,0 L0.5,0 L0.5,40 L0,40 Z" />
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
        </Border>
        <Border IsHitTestVisible="False" Opacity="0.3">
            <Border.Background>
                <DrawingBrush TileMode="Tile"
                              DestinationRect="0,0,200,200"
                              SourceRect="0,0,200,200">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="#33B4BEE6"
                                             Geometry="M0,0 L200,0 L200,0.7 L0,0.7 Z M0,0 L0.7,0 L0.7,200 L0,200 Z" />
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
        </Border>

        <!-- ═══ Animated scanline (cyan bar sweeping down, 10s loop) ═══ -->
        <Border IsHitTestVisible="False"
                Height="2"
                VerticalAlignment="Top"
                Opacity="0.22"
                RenderTransformOrigin="0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Offset="0" Color="Transparent" />
                    <GradientStop Offset="0.5" Color="{DynamicResource MwCyanColor}" />
                    <GradientStop Offset="1" Color="Transparent" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.RenderTransform>
                <TranslateTransform />
            </Border.RenderTransform>
            <Border.Styles>
                <Style Selector="Border">
                    <Style.Animations>
                        <Animation Duration="0:0:10" IterationCount="INFINITE">
                            <KeyFrame Cue="0%">
                                <Setter Property="TranslateTransform.Y" Value="-20" />
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="TranslateTransform.Y" Value="900" />
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Border.Styles>
        </Border>

        <!-- ═══ Animated ember particles (14 rising from bottom, staggered) ═══
             Each ember has its own class (mw-ember-N) with a unique Delay so
             they desync permanently after the first iteration. Durations also
             vary slightly (6–11s) so they never re-align over time. -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Canvas.Styles>
                <!-- Shared layout (opacity start) — selects all ember classes -->
                <Style Selector="Ellipse.mw-ember">
                    <Setter Property="Opacity" Value="0" />
                </Style>
                <Style Selector="Ellipse.mw-ember-0">
                    <Style.Animations>
                        <Animation Duration="0:0:7" Delay="0:0:0" IterationCount="INFINITE">
                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                            <KeyFrame Cue="15%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="-180" /><Setter Property="TranslateTransform.X" Value="14" /></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
                <Style Selector="Ellipse.mw-ember-1">
                    <Style.Animations>
                        <Animation Duration="0:0:9" Delay="0:0:0.5" IterationCount="INFINITE">
                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                            <KeyFrame Cue="15%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="-180" /><Setter Property="TranslateTransform.X" Value="-12" /></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
                <Style Selector="Ellipse.mw-ember-2">
                    <Style.Animations>
                        <Animation Duration="0:0:8" Delay="0:0:1.1" IterationCount="INFINITE">
                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                            <KeyFrame Cue="15%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="-180" /><Setter Property="TranslateTransform.X" Value="18" /></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
                <Style Selector="Ellipse.mw-ember-3">
                    <Style.Animations>
                        <Animation Duration="0:0:10" Delay="0:0:1.7" IterationCount="INFINITE">
                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                            <KeyFrame Cue="15%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="-180" /><Setter Property="TranslateTransform.X" Value="-16" /></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
                <Style Selector="Ellipse.mw-ember-4">
                    <Style.Animations>
                        <Animation Duration="0:0:7.5" Delay="0:0:2.3" IterationCount="INFINITE">
                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                            <KeyFrame Cue="15%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="-180" /><Setter Property="TranslateTransform.X" Value="10" /></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
                <Style Selector="Ellipse.mw-ember-5">
                    <Style.Animations>
                        <Animation Duration="0:0:9.5" Delay="0:0:2.9" IterationCount="INFINITE">
                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                            <KeyFrame Cue="15%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="-180" /><Setter Property="TranslateTransform.X" Value="-20" /></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
                <Style Selector="Ellipse.mw-ember-6">
                    <Style.Animations>
                        <Animation Duration="0:0:8.5" Delay="0:0:3.5" IterationCount="INFINITE">
                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                            <KeyFrame Cue="15%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="-180" /><Setter Property="TranslateTransform.X" Value="22" /></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
                <Style Selector="Ellipse.mw-ember-7">
                    <Style.Animations>
                        <Animation Duration="0:0:7" Delay="0:0:4.1" IterationCount="INFINITE">
                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                            <KeyFrame Cue="15%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="-180" /><Setter Property="TranslateTransform.X" Value="-14" /></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
                <Style Selector="Ellipse.mw-ember-8">
                    <Style.Animations>
                        <Animation Duration="0:0:10" Delay="0:0:4.7" IterationCount="INFINITE">
                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                            <KeyFrame Cue="15%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="-180" /><Setter Property="TranslateTransform.X" Value="16" /></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
                <Style Selector="Ellipse.mw-ember-9">
                    <Style.Animations>
                        <Animation Duration="0:0:8" Delay="0:0:5.3" IterationCount="INFINITE">
                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                            <KeyFrame Cue="15%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="-180" /><Setter Property="TranslateTransform.X" Value="-24" /></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
                <Style Selector="Ellipse.mw-ember-10">
                    <Style.Animations>
                        <Animation Duration="0:0:9" Delay="0:0:5.9" IterationCount="INFINITE">
                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                            <KeyFrame Cue="15%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="-180" /><Setter Property="TranslateTransform.X" Value="12" /></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
                <Style Selector="Ellipse.mw-ember-11">
                    <Style.Animations>
                        <Animation Duration="0:0:7.5" Delay="0:0:6.5" IterationCount="INFINITE">
                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                            <KeyFrame Cue="15%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="-180" /><Setter Property="TranslateTransform.X" Value="-18" /></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
                <Style Selector="Ellipse.mw-ember-12">
                    <Style.Animations>
                        <Animation Duration="0:0:10" Delay="0:0:7.1" IterationCount="INFINITE">
                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                            <KeyFrame Cue="15%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="-180" /><Setter Property="TranslateTransform.X" Value="20" /></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
                <Style Selector="Ellipse.mw-ember-13">
                    <Style.Animations>
                        <Animation Duration="0:0:8.5" Delay="0:0:7.7" IterationCount="INFINITE">
                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                            <KeyFrame Cue="15%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="-180" /><Setter Property="TranslateTransform.X" Value="-10" /></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Canvas.Styles>

            <!-- 14 embers — scattered x%, varied size/color, staggered start. -->
            <Ellipse Classes="mw-ember mw-ember-0" Canvas.Left="60"  Canvas.Bottom="0" Width="3" Height="3"
                     Fill="{DynamicResource MwMolten}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="9" Color="#FF7A1A" OffsetX="0" OffsetY="0" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Classes="mw-ember mw-ember-1" Canvas.Left="150" Canvas.Bottom="0" Width="2" Height="2"
                     Fill="{DynamicResource MwMoltenHi}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="6" Color="#FFD080" OffsetX="0" OffsetY="0" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Classes="mw-ember mw-ember-2" Canvas.Left="240" Canvas.Bottom="0" Width="4" Height="4"
                     Fill="{DynamicResource MwMolten}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="12" Color="#FF7A1A" OffsetX="0" OffsetY="0" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Classes="mw-ember mw-ember-3" Canvas.Left="330" Canvas.Bottom="0" Width="3" Height="3"
                     Fill="{DynamicResource MwMoltenHi}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="9" Color="#FFD080" OffsetX="0" OffsetY="0" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Classes="mw-ember mw-ember-4" Canvas.Left="420" Canvas.Bottom="0" Width="2" Height="2"
                     Fill="{DynamicResource MwMolten}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="6" Color="#FF7A1A" OffsetX="0" OffsetY="0" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Classes="mw-ember mw-ember-5" Canvas.Left="510" Canvas.Bottom="0" Width="4" Height="4"
                     Fill="{DynamicResource MwMoltenHi}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="12" Color="#FFD080" OffsetX="0" OffsetY="0" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Classes="mw-ember mw-ember-6" Canvas.Left="600" Canvas.Bottom="0" Width="3" Height="3"
                     Fill="{DynamicResource MwMolten}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="9" Color="#FF7A1A" OffsetX="0" OffsetY="0" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Classes="mw-ember mw-ember-7" Canvas.Left="690" Canvas.Bottom="0" Width="2" Height="2"
                     Fill="{DynamicResource MwMoltenHi}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="6" Color="#FFD080" OffsetX="0" OffsetY="0" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Classes="mw-ember mw-ember-8" Canvas.Left="780" Canvas.Bottom="0" Width="4" Height="4"
                     Fill="{DynamicResource MwMolten}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="12" Color="#FF7A1A" OffsetX="0" OffsetY="0" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Classes="mw-ember mw-ember-9" Canvas.Left="870" Canvas.Bottom="0" Width="3" Height="3"
                     Fill="{DynamicResource MwMoltenHi}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="9" Color="#FFD080" OffsetX="0" OffsetY="0" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Classes="mw-ember mw-ember-10" Canvas.Left="960" Canvas.Bottom="0" Width="2" Height="2"
                     Fill="{DynamicResource MwMolten}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="6" Color="#FF7A1A" OffsetX="0" OffsetY="0" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Classes="mw-ember mw-ember-11" Canvas.Left="1050" Canvas.Bottom="0" Width="4" Height="4"
                     Fill="{DynamicResource MwMoltenHi}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="12" Color="#FFD080" OffsetX="0" OffsetY="0" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Classes="mw-ember mw-ember-12" Canvas.Left="1140" Canvas.Bottom="0" Width="3" Height="3"
                     Fill="{DynamicResource MwMolten}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="9" Color="#FF7A1A" OffsetX="0" OffsetY="0" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Classes="mw-ember mw-ember-13" Canvas.Left="1230" Canvas.Bottom="0" Width="2" Height="2"
                     Fill="{DynamicResource MwMoltenHi}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="6" Color="#FFD080" OffsetX="0" OffsetY="0" /></Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <nodify:NodifyEditor x:Name="Editor"
                             ItemsSource="{Binding Nodes}"
                             Connections="{Binding Connections}"
                             PendingConnection="{Binding PendingConnection}"
                             ItemsDragStartedCommand="{Binding ItemsDragStartedCommand}"
                             ItemsDragCompletedCommand="{Binding ItemsDragCompletedCommand}"
                             Background="Transparent"
                             GridCellSize="40"
                             DragDrop.AllowDrop="True">

            <nodify:NodifyEditor.Styles>
                <Style Selector="nodify|ItemContainer" x:DataType="vm:PipelineNodeViewModel">
                    <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="0" />
                    <!-- Don't clip per-item content so the station halo can bloom
                         outside the container's logical rect. Without this Nodify
                         clips anything painted beyond the station's 200×130. -->
                    <Setter Property="ClipToBounds" Value="False" />
                </Style>
                <Style Selector="nodify|ItemContainer:selected">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </nodify:NodifyEditor.Styles>

            <nodify:NodifyEditor.ItemTemplate>
                <DataTemplate x:DataType="vm:PipelineNodeViewModel">
                    <!-- ═══ Molten Works cast-iron station ═══ -->
                    <Grid Width="200" Height="130" ClipToBounds="False">

                        <!-- ═══ Running aura: soft rectangular-aspect cloud behind iron ═══
                             Border margin is asymmetric so the aura element is
                             wider than it is tall, matching the station's 200×130
                             aspect. Result: radial gradient produces a horizontally-
                             elongated halo that reads as "cloud around a station"
                             instead of "perfect circle around a station". -->
                        <Border IsHitTestVisible="False"
                                Margin="-70,-50,-70,-50"
                                Background="{Binding MwAuraBrush}"
                                IsVisible="{Binding IsRunning}"
                                Classes="mw-aura"
                                Classes.running="{Binding IsRunning}">
                            <Border.Styles>
                                <Style Selector="Border.mw-aura.running">
                                    <Style.Animations>
                                        <Animation Duration="0:0:1.8" IterationCount="INFINITE">
                                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.7" /></KeyFrame>
                                            <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.7" /></KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Border.Styles>
                        </Border>

                        <!-- Iron body (200x130, rounded 3px, iron gradient).
                             Running: DropShadowEffect paints a tight rectangular
                             edge glow ON TOP of the soft cloud aura — the two
                             layer to match the concept's drop-shadow look. -->
                        <Border CornerRadius="3"
                                Background="{DynamicResource MwIronBody}"
                                BorderBrush="#050303"
                                BorderThickness="1"
                                BoxShadow="0 6 16 0 #B3000000"
                                Classes.running="{Binding IsRunning}">
                            <Border.Styles>
                                <Style Selector="Border.running">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="28"
                                                              Color="{Binding CategoryGlowColor}"
                                                              OffsetX="0"
                                                              OffsetY="0"
                                                              Opacity="0.9" />
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Border.Styles>
                            <!-- Inset highlight on top + subtle bottom shadow -->
                            <Border CornerRadius="3"
                                    BorderThickness="0,1,0,1"
                                    ClipToBounds="True">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                        <GradientStop Offset="0" Color="#1EFFC896" />
                                        <GradientStop Offset="0.02" Color="Transparent" />
                                        <GradientStop Offset="0.98" Color="Transparent" />
                                        <GradientStop Offset="1" Color="#B3000000" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                        </Border>

                        <!-- Heat pulse: category radial glow inside the iron when running. -->
                        <Border IsHitTestVisible="False"
                                CornerRadius="2"
                                Margin="8"
                                Background="{Binding MwHeatPulseBrush}"
                                Opacity="0.85"
                                IsVisible="{Binding IsRunning}"
                                Classes="heat-pulse"
                                Classes.running="{Binding IsRunning}">
                            <Border.Effect>
                                <BlurEffect Radius="10" />
                            </Border.Effect>
                            <Border.Styles>
                                <Style Selector="Border.heat-pulse.running">
                                    <Style.Animations>
                                        <Animation Duration="0:0:1.6" IterationCount="INFINITE">
                                            <KeyFrame Cue="0%">
                                                <Setter Property="Opacity" Value="0.85" />
                                                <Setter Property="(BlurEffect.Radius)" Value="10" />
                                            </KeyFrame>
                                            <KeyFrame Cue="50%">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="(BlurEffect.Radius)" Value="14" />
                                            </KeyFrame>
                                            <KeyFrame Cue="100%">
                                                <Setter Property="Opacity" Value="0.85" />
                                                <Setter Property="(BlurEffect.Radius)" Value="10" />
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Border.Styles>
                        </Border>

                        <!-- Rivets at 4 corners (6px, inset 7px) -->
                        <Ellipse Width="6" Height="6"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Margin="7,7,0,0">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.3,0.3" GradientOrigin="0.3,0.3" RadiusX="0.7" RadiusY="0.7">
                                    <GradientStop Offset="0" Color="#8a7868" />
                                    <GradientStop Offset="0.75" Color="#2a1a12" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="6" Height="6"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,7,7,0">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.3,0.3" GradientOrigin="0.3,0.3" RadiusX="0.7" RadiusY="0.7">
                                    <GradientStop Offset="0" Color="#8a7868" />
                                    <GradientStop Offset="0.75" Color="#2a1a12" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="6" Height="6"
                                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                 Margin="7,0,0,7">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.3,0.3" GradientOrigin="0.3,0.3" RadiusX="0.7" RadiusY="0.7">
                                    <GradientStop Offset="0" Color="#8a7868" />
                                    <GradientStop Offset="0.75" Color="#2a1a12" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="6" Height="6"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,7,7">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.3,0.3" GradientOrigin="0.3,0.3" RadiusX="0.7" RadiusY="0.7">
                                    <GradientStop Offset="0" Color="#8a7868" />
                                    <GradientStop Offset="0.75" Color="#2a1a12" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Top code strip: code (left) + LIVE/IDLE pill (right) -->
                        <Grid Margin="12,6,12,0"
                              VerticalAlignment="Top"
                              Height="18"
                              ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding MwCode}"
                                       FontFamily="{DynamicResource MwMono}"
                                       FontSize="8" FontWeight="SemiBold"
                                       LetterSpacing="1.6"
                                       Foreground="{Binding MwNeonBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center">
                                <!-- Pulsing LIVE dot when running (1s opacity cycle) -->
                                <Ellipse Width="5" Height="5"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding IsRunning}"
                                         Fill="{Binding MwNeonBrush}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6"
                                                          Color="{Binding CategoryGlowColor}"
                                                          OffsetX="0"
                                                          OffsetY="0" />
                                    </Ellipse.Effect>
                                    <Ellipse.Styles>
                                        <Style Selector="Ellipse">
                                            <Style.Animations>
                                                <Animation Duration="0:0:1" IterationCount="INFINITE">
                                                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
                                                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                                                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </Ellipse.Styles>
                                </Ellipse>
                                <Ellipse Width="5" Height="5"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding !IsRunning}"
                                         Fill="{DynamicResource MwFaint}" />
                                <TextBlock Text="LIVE"
                                           IsVisible="{Binding IsRunning}"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="8"
                                           LetterSpacing="1.6"
                                           Foreground="{Binding MwNeonBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="IDLE"
                                           IsVisible="{Binding !IsRunning}"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="8"
                                           LetterSpacing="1.6"
                                           Foreground="{DynamicResource MwFaint}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Main body: icon well + text column.
                             Margins match concept: inset 28/38/28/14 (top/right/bottom/left).
                             ColumnDefinitions 54 / gap 12 / * matches concept's
                             54×54 icon well + 12px flex gap. -->
                        <Grid Margin="14,28,38,28"
                              ColumnDefinitions="54,12,*">
                            <!-- Icon well (54×54 per concept, with running glow halo via Effect) -->
                            <Grid Grid.Column="0" Width="54" Height="54" VerticalAlignment="Top">
                                <!-- Glow halo: sits behind the iron well, only when running. -->
                                <Border Width="54" Height="54"
                                        CornerRadius="3"
                                        Background="{Binding MwGlowBrush}"
                                        Opacity="0.55"
                                        IsVisible="{Binding IsRunning}"
                                        IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="36"
                                                          Color="{Binding CategoryGlowColor}"
                                                          OffsetX="0"
                                                          OffsetY="0" />
                                    </Border.Effect>
                                </Border>
                                <Border Width="54" Height="54"
                                        CornerRadius="3"
                                        BorderThickness="1"
                                        BorderBrush="#050303">
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.3,0.2" GradientOrigin="0.3,0.2" RadiusX="0.9" RadiusY="0.9">
                                            <GradientStop Offset="0" Color="#3a1808" />
                                            <GradientStop Offset="1" Color="#0a0503" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                    <!-- Icon: ash/muted when idle, full category neon + brighter stroke when running. -->
                                    <Viewbox Width="30" Height="30">
                                        <Grid>
                                            <Path Data="{Binding MwIconGeometry}"
                                                  Stroke="{DynamicResource MwAsh}"
                                                  StrokeThickness="1.7"
                                                  StrokeLineCap="Round"
                                                  StrokeJoin="Round"
                                                  Width="40" Height="40"
                                                  IsVisible="{Binding !IsRunning}" />
                                            <Path Data="{Binding MwIconGeometry}"
                                                  Stroke="{Binding MwNeonBrush}"
                                                  StrokeThickness="2.2"
                                                  StrokeLineCap="Round"
                                                  StrokeJoin="Round"
                                                  Width="40" Height="40"
                                                  IsVisible="{Binding IsRunning}" />
                                        </Grid>
                                    </Viewbox>
                                </Border>
                            </Grid>

                            <!-- Text column -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Vertical"
                                        Spacing="3"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           FontFamily="{DynamicResource MwSerif}"
                                           FontSize="18"
                                           LineHeight="18"
                                           Foreground="{DynamicResource MwBone}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding MwSub}"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="9"
                                           LetterSpacing="1"
                                           Foreground="{DynamicResource MwIronLite}"
                                           TextTrimming="CharacterEllipsis" />
                                <!-- Config preview -->
                                <Border Padding="6,3"
                                        Background="{DynamicResource MwInkA45}"
                                        BorderThickness="2,0,0,0"
                                        BorderBrush="{Binding MwNeonBrush}"
                                        IsVisible="{Binding ConfigPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Margin="0,2,0,0">
                                    <TextBlock Text="{Binding ConfigPreview}"
                                               FontFamily="{DynamicResource MwMono}"
                                               FontSize="9.5"
                                               Foreground="{DynamicResource MwBone}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="95" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Right-side gauge strip: T / p / Δ.
                             Per concept: opacity 0.5 idle / 1.0 running, value color
                             swaps from IronLite (dim) to category neon when running. -->
                        <StackPanel Orientation="Vertical"
                                    Spacing="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,30,4,12"
                                    Width="22">
                            <StackPanel.Styles>
                                <Style Selector="Grid.mw-gauge">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Style>
                                <Style Selector="Grid.mw-gauge.running">
                                    <Setter Property="Opacity" Value="1.0" />
                                </Style>
                            </StackPanel.Styles>
                            <Grid ColumnDefinitions="*,Auto"
                                  Classes="mw-gauge"
                                  Classes.running="{Binding IsRunning}">
                                <TextBlock Grid.Column="0" Text="T"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="7"
                                           Foreground="{DynamicResource MwFaint}" />
                                <TextBlock Grid.Column="1" Text="86"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="7"
                                           IsVisible="{Binding !IsRunning}"
                                           Foreground="{DynamicResource MwIronLite}" />
                                <TextBlock Grid.Column="1" Text="86"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="7"
                                           IsVisible="{Binding IsRunning}"
                                           Foreground="{Binding MwNeonBrush}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto"
                                  Classes="mw-gauge"
                                  Classes.running="{Binding IsRunning}">
                                <TextBlock Grid.Column="0" Text="p"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="7"
                                           Foreground="{DynamicResource MwFaint}" />
                                <TextBlock Grid.Column="1" Text="72"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="7"
                                           IsVisible="{Binding !IsRunning}"
                                           Foreground="{DynamicResource MwIronLite}" />
                                <TextBlock Grid.Column="1" Text="72"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="7"
                                           IsVisible="{Binding IsRunning}"
                                           Foreground="{Binding MwNeonBrush}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto"
                                  Classes="mw-gauge"
                                  Classes.running="{Binding IsRunning}">
                                <TextBlock Grid.Column="0" Text="Δ"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="7"
                                           Foreground="{DynamicResource MwFaint}" />
                                <TextBlock Grid.Column="1" Text="43"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="7"
                                           IsVisible="{Binding !IsRunning}"
                                           Foreground="{DynamicResource MwIronLite}" />
                                <TextBlock Grid.Column="1" Text="43"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="7"
                                           IsVisible="{Binding IsRunning}"
                                           Foreground="{Binding MwNeonBrush}" />
                            </Grid>
                        </StackPanel>

                        <!-- Input connectors (left edge) -->
                        <ItemsControl ItemsSource="{Binding Input}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="-8,0,0,0"
                                      IsHitTestVisible="True"
                                      ZIndex="5">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PipelineConnectorViewModel">
                                    <nodifyConn:Connector Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                          IsConnected="{Binding IsConnected}"
                                                          Width="12" Height="18"
                                                          Cursor="Hand">
                                        <nodifyConn:Connector.Template>
                                            <ControlTemplate>
                                                <Border Width="12" Height="18"
                                                        CornerRadius="3,0,0,3"
                                                        BorderBrush="#050303"
                                                        BorderThickness="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                            <GradientStop Offset="0" Color="#050303" />
                                                            <GradientStop Offset="1" Color="#4a4a58" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Grid HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"
                                                          Margin="3,0,0,0">
                                                        <Ellipse Width="6" Height="6"
                                                                 Fill="{DynamicResource MwChromeDk}"
                                                                 IsVisible="{Binding !Node.IsRunning}" />
                                                        <Ellipse Width="6" Height="6"
                                                                 Fill="{DynamicResource MwMercury}"
                                                                 IsVisible="{Binding Node.IsRunning}">
                                                            <Ellipse.Effect>
                                                                <DropShadowEffect BlurRadius="8"
                                                                                  Color="{Binding Node.CategoryGlowColor}"
                                                                                  OffsetX="0"
                                                                                  OffsetY="0" />
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </nodifyConn:Connector.Template>
                                    </nodifyConn:Connector>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Output connectors (right edge) -->
                        <ItemsControl ItemsSource="{Binding Output}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,-8,0"
                                      IsHitTestVisible="True"
                                      ZIndex="5">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PipelineConnectorViewModel">
                                    <nodifyConn:Connector Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                          IsConnected="{Binding IsConnected}"
                                                          Width="12" Height="18"
                                                          Cursor="Hand">
                                        <nodifyConn:Connector.Template>
                                            <ControlTemplate>
                                                <Border Width="12" Height="18"
                                                        CornerRadius="0,3,3,0"
                                                        BorderBrush="#050303"
                                                        BorderThickness="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                            <GradientStop Offset="0" Color="#4a4a58" />
                                                            <GradientStop Offset="1" Color="#050303" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Grid HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,3,0">
                                                        <Ellipse Width="6" Height="6"
                                                                 Fill="{DynamicResource MwChromeDk}"
                                                                 IsVisible="{Binding !Node.IsRunning}" />
                                                        <Ellipse Width="6" Height="6"
                                                                 Fill="{DynamicResource MwMercury}"
                                                                 IsVisible="{Binding Node.IsRunning}">
                                                            <Ellipse.Effect>
                                                                <DropShadowEffect BlurRadius="8"
                                                                                  Color="{Binding Node.CategoryGlowColor}"
                                                                                  OffsetX="0"
                                                                                  OffsetY="0" />
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </nodifyConn:Connector.Template>
                                    </nodifyConn:Connector>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Selection glow: outer cyan drop-shadow when selected -->
                        <Border IsHitTestVisible="False"
                                CornerRadius="3"
                                IsVisible="{Binding IsSelected}"
                                BoxShadow="0 0 16 0 #992EF0FF" />
                    </Grid>
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>

            <nodify:NodifyEditor.ConnectionTemplate>
                <DataTemplate x:DataType="vm:PipelineConnectionViewModel">
                    <!-- Chrome pipe: 5-layer stroke (shadow → outer → core → inner → highlight). -->
                    <Grid>
                        <views:MwPipeConnection Source="{Binding Source.Anchor}"
                                                Target="{Binding Target.Anchor}"
                                                StrokeLineCap="Round"
                                                Stroke="#D9000000"
                                                StrokeThickness="16" />
                        <views:MwPipeConnection Source="{Binding Source.Anchor}"
                                                Target="{Binding Target.Anchor}"
                                                StrokeLineCap="Round"
                                                Stroke="{DynamicResource MwChromeDk}"
                                                StrokeThickness="12" />
                        <views:MwPipeConnection Source="{Binding Source.Anchor}"
                                                Target="{Binding Target.Anchor}"
                                                StrokeLineCap="Round"
                                                Stroke="{DynamicResource MwChrome}"
                                                StrokeThickness="9" />
                        <views:MwPipeConnection Source="{Binding Source.Anchor}"
                                                Target="{Binding Target.Anchor}"
                                                StrokeLineCap="Round"
                                                Stroke="#050303"
                                                StrokeThickness="6" />
                        <!-- Inner liquid, dark when idle (hidden while running) -->
                        <views:MwPipeConnection Source="{Binding Source.Anchor}"
                                                Target="{Binding Target.Anchor}"
                                                StrokeLineCap="Round"
                                                Stroke="#1a1208"
                                                StrokeThickness="5"
                                                IsVisible="{Binding !IsRunning}" />
                        <!-- Molten liquid when running (with orange glow) -->
                        <views:MwPipeConnection Source="{Binding Source.Anchor}"
                                                Target="{Binding Target.Anchor}"
                                                StrokeLineCap="Round"
                                                Stroke="{DynamicResource MwPipeLiquid}"
                                                StrokeThickness="5"
                                                IsVisible="{Binding IsRunning}">
                            <views:MwPipeConnection.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#FF7A1A" OffsetX="0" OffsetY="0" />
                            </views:MwPipeConnection.Effect>
                        </views:MwPipeConnection>
                        <!-- Bright molten core when running -->
                        <views:MwPipeConnection Source="{Binding Source.Anchor}"
                                                Target="{Binding Target.Anchor}"
                                                StrokeLineCap="Round"
                                                Stroke="{DynamicResource MwMoltenHi}"
                                                StrokeThickness="1.5"
                                                Opacity="0.9"
                                                IsVisible="{Binding IsRunning}" />
                        <!-- Chrome top highlight -->
                        <views:MwPipeConnection Source="{Binding Source.Anchor}"
                                                Target="{Binding Target.Anchor}"
                                                StrokeLineCap="Round"
                                                Stroke="{DynamicResource MwChromeHi}"
                                                StrokeThickness="1"
                                                Opacity="0.7" />

                        <!-- ═══ Mercury droplets (visible while running) ═══
                             Four beads ride the bezier with staggered delays so the
                             pipe looks like liquid metal flowing through chrome. -->
                        <Canvas IsVisible="{Binding IsRunning}" IsHitTestVisible="False">
                            <views:MwMercuryDroplet x:Name="Droplet0"
                                                    Source="{Binding Source.Anchor}"
                                                    Target="{Binding Target.Anchor}">
                                <views:MwMercuryDroplet.Styles>
                                    <Style Selector="views|MwMercuryDroplet">
                                        <Style.Animations>
                                            <Animation Duration="0:0:2.4" Delay="0:0:0" IterationCount="INFINITE">
                                                <KeyFrame Cue="0%"><Setter Property="views:MwMercuryDroplet.Progress" Value="0" /></KeyFrame>
                                                <KeyFrame Cue="100%"><Setter Property="views:MwMercuryDroplet.Progress" Value="1" /></KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </views:MwMercuryDroplet.Styles>
                            </views:MwMercuryDroplet>
                            <views:MwMercuryDroplet x:Name="Droplet1"
                                                    Source="{Binding Source.Anchor}"
                                                    Target="{Binding Target.Anchor}">
                                <views:MwMercuryDroplet.Styles>
                                    <Style Selector="views|MwMercuryDroplet">
                                        <Style.Animations>
                                            <Animation Duration="0:0:2.4" Delay="0:0:0.6" IterationCount="INFINITE">
                                                <KeyFrame Cue="0%"><Setter Property="views:MwMercuryDroplet.Progress" Value="0" /></KeyFrame>
                                                <KeyFrame Cue="100%"><Setter Property="views:MwMercuryDroplet.Progress" Value="1" /></KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </views:MwMercuryDroplet.Styles>
                            </views:MwMercuryDroplet>
                            <views:MwMercuryDroplet x:Name="Droplet2"
                                                    Source="{Binding Source.Anchor}"
                                                    Target="{Binding Target.Anchor}">
                                <views:MwMercuryDroplet.Styles>
                                    <Style Selector="views|MwMercuryDroplet">
                                        <Style.Animations>
                                            <Animation Duration="0:0:2.4" Delay="0:0:1.2" IterationCount="INFINITE">
                                                <KeyFrame Cue="0%"><Setter Property="views:MwMercuryDroplet.Progress" Value="0" /></KeyFrame>
                                                <KeyFrame Cue="100%"><Setter Property="views:MwMercuryDroplet.Progress" Value="1" /></KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </views:MwMercuryDroplet.Styles>
                            </views:MwMercuryDroplet>
                            <views:MwMercuryDroplet x:Name="Droplet3"
                                                    Source="{Binding Source.Anchor}"
                                                    Target="{Binding Target.Anchor}">
                                <views:MwMercuryDroplet.Styles>
                                    <Style Selector="views|MwMercuryDroplet">
                                        <Style.Animations>
                                            <Animation Duration="0:0:2.4" Delay="0:0:1.8" IterationCount="INFINITE">
                                                <KeyFrame Cue="0%"><Setter Property="views:MwMercuryDroplet.Progress" Value="0" /></KeyFrame>
                                                <KeyFrame Cue="100%"><Setter Property="views:MwMercuryDroplet.Progress" Value="1" /></KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </views:MwMercuryDroplet.Styles>
                            </views:MwMercuryDroplet>
                        </Canvas>
                    </Grid>
                </DataTemplate>
            </nodify:NodifyEditor.ConnectionTemplate>

            <nodify:NodifyEditor.PendingConnectionTemplate>
                <DataTemplate x:DataType="vm:PipelinePendingConnectionViewModel">
                    <nodifyConn:PendingConnection IsVisible="{Binding IsVisible}"
                                                  StartedCommand="{Binding StartCommand}"
                                                  CompletedCommand="{Binding FinishCommand}"
                                                  EnablePreview="True"
                                                  EnableSnapping="True"
                                                  Stroke="{DynamicResource MwMolten}"
                                                  StrokeThickness="3"
                                                  PreviewTarget="{Binding PreviewTarget, Mode=OneWayToSource}" />
                </DataTemplate>
            </nodify:NodifyEditor.PendingConnectionTemplate>

        </nodify:NodifyEditor>

        <!-- HUD corner brackets (magenta, 18x18, .5 opacity) -->
        <Border IsHitTestVisible="False"
                Width="18" Height="18"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="12,12,0,0"
                BorderBrush="{DynamicResource MwMag}"
                BorderThickness="1,1,0,0"
                Opacity="0.5" />
        <Border IsHitTestVisible="False"
                Width="18" Height="18"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,12,12,0"
                BorderBrush="{DynamicResource MwMag}"
                BorderThickness="0,1,1,0"
                Opacity="0.5" />
        <Border IsHitTestVisible="False"
                Width="18" Height="18"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="12,0,0,12"
                BorderBrush="{DynamicResource MwMag}"
                BorderThickness="1,0,0,1"
                Opacity="0.5" />
        <Border IsHitTestVisible="False"
                Width="18" Height="18"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,12,12"
                BorderBrush="{DynamicResource MwMag}"
                BorderThickness="0,0,1,1"
                Opacity="0.5" />

        <!-- Hint caption top-left -->
        <TextBlock IsHitTestVisible="False"
                   Text="drag stations · click to select · ▶ ignite to run"
                   FontFamily="{DynamicResource MwMono}"
                   FontSize="10"
                   LetterSpacing="1"
                   Foreground="{DynamicResource MwFaint}"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="40,14,0,0" />

        <!-- System HUD bottom-right -->
        <Border IsHitTestVisible="False"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,38,14"
                Padding="10,8"
                Background="{DynamicResource MwInkA85}"
                BorderBrush="{DynamicResource MwIronDark}"
                BorderThickness="1">
            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBlock Text="// SYSTEM"
                           FontFamily="{DynamicResource MwMono}"
                           FontSize="8"
                           LetterSpacing="1.6"
                           Foreground="{DynamicResource MwFaint}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="lat:" FontFamily="{DynamicResource MwMono}" FontSize="10" Foreground="{DynamicResource MwFaint}" />
                        <TextBlock Text="6.2ms" FontFamily="{DynamicResource MwMono}" FontSize="10" Foreground="{DynamicResource MwCyan}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="mem:" FontFamily="{DynamicResource MwMono}" FontSize="10" Foreground="{DynamicResource MwFaint}" />
                        <TextBlock Text="142MB" FontFamily="{DynamicResource MwMono}" FontSize="10" Foreground="{DynamicResource MwLime}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="err:" FontFamily="{DynamicResource MwMono}" FontSize="10" Foreground="{DynamicResource MwFaint}" />
                        <TextBlock Text="0" FontFamily="{DynamicResource MwMono}" FontSize="10" Foreground="{DynamicResource MwLime}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ Empty state: Mw "Build your pipeline from raw ore" ═══ -->
        <Border IsVisible="{Binding !HasNodes}"
                IsHitTestVisible="True"
                DragDrop.AllowDrop="True">
            <Border.Background>
                <SolidColorBrush Color="#08060a" Opacity="0.7" />
            </Border.Background>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="18"
                        MaxWidth="920">

                <!-- Eyebrow -->
                <TextBlock Text="// BOOT.SEQ · READY"
                           FontFamily="{DynamicResource MwMono}"
                           FontSize="10"
                           LetterSpacing="4"
                           Foreground="{DynamicResource MwCyan}"
                           HorizontalAlignment="Center" />

                <!-- Hero headline -->
                <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <TextBlock Text="Build your pipeline"
                               FontFamily="{DynamicResource MwSerifRegular}"
                               FontSize="62"
                               FontWeight="Normal"
                               LineHeight="62"
                               Foreground="{DynamicResource MwBone}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="from raw ore."
                               FontFamily="{DynamicResource MwSerif}"
                               FontSize="62"
                               FontStyle="Italic"
                               FontWeight="Light"
                               LineHeight="62"
                               Foreground="{DynamicResource MwMolten}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Subhead mono -->
                <TextBlock Text="> start from a template below, or drag operations from the library onto the canvas."
                           FontFamily="{DynamicResource MwMono}"
                           FontSize="12"
                           LineHeight="18"
                           Foreground="{DynamicResource MwAsh}"
                           HorizontalAlignment="Center" />

                <!-- Template cards: 4 cast-iron buttons -->
                <UniformGrid Columns="4" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button Classes="templateButton" Margin="8"
                            Tag="photo-import-by-date"
                            Click="OnTemplateButtonClick"
                            Width="220">
                        <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Left">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="TPL.01"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="9"
                                           LetterSpacing="2.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MwMoltenHi}" />
                                <Rectangle Grid.Column="1" Width="6" Height="6" Fill="{DynamicResource MwCyan}" />
                            </Grid>
                            <TextBlock Text="Photo Import"
                                       FontFamily="{DynamicResource MwSerif}"
                                       FontSize="22"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource MwBone}" />
                            <TextBlock Text="camera SD → dated folders → web sizes"
                                       FontFamily="{DynamicResource MwMono}"
                                       FontSize="10"
                                       Foreground="{DynamicResource MwAsh}"
                                       TextWrapping="Wrap" />
                            <Border Height="1"
                                    Background="{DynamicResource MwIronDark}"
                                    Margin="0,8,0,0" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                <TextBlock Grid.Column="0"
                                           Text="5 stations"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="9"
                                           LetterSpacing="1.2"
                                           Foreground="{DynamicResource MwIronLite}" />
                                <TextBlock Grid.Column="1"
                                           Text="ignite ▸"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="9"
                                           LetterSpacing="1.2"
                                           Foreground="{DynamicResource MwMolten}" />
                            </Grid>
                        </StackPanel>
                    </Button>
                    <Button Classes="templateButton" Margin="8"
                            Tag="batch-sequential-rename"
                            Click="OnTemplateButtonClick"
                            Width="220">
                        <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Left">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="TPL.02"
                                           FontFamily="{DynamicResource MwMono}" FontSize="9"
                                           LetterSpacing="2.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MwMoltenHi}" />
                                <Rectangle Grid.Column="1" Width="6" Height="6" Fill="{DynamicResource MwCyan}" />
                            </Grid>
                            <TextBlock Text="Batch Rename"
                                       FontFamily="{DynamicResource MwSerif}" FontSize="22" FontStyle="Italic"
                                       Foreground="{DynamicResource MwBone}" />
                            <TextBlock Text="sequential counter with date prefix"
                                       FontFamily="{DynamicResource MwMono}" FontSize="10"
                                       Foreground="{DynamicResource MwAsh}" TextWrapping="Wrap" />
                            <Border Height="1" Background="{DynamicResource MwIronDark}" Margin="0,8,0,0" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                <TextBlock Grid.Column="0" Text="3 stations"
                                           FontFamily="{DynamicResource MwMono}" FontSize="9"
                                           LetterSpacing="1.2" Foreground="{DynamicResource MwIronLite}" />
                                <TextBlock Grid.Column="1" Text="ignite ▸"
                                           FontFamily="{DynamicResource MwMono}" FontSize="9"
                                           LetterSpacing="1.2" Foreground="{DynamicResource MwMolten}" />
                            </Grid>
                        </StackPanel>
                    </Button>
                    <Button Classes="templateButton" Margin="8"
                            Tag="image-web-export"
                            Click="OnTemplateButtonClick"
                            Width="220">
                        <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Left">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="TPL.03"
                                           FontFamily="{DynamicResource MwMono}" FontSize="9"
                                           LetterSpacing="2.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MwMoltenHi}" />
                                <Rectangle Grid.Column="1" Width="6" Height="6" Fill="{DynamicResource MwCyan}" />
                            </Grid>
                            <TextBlock Text="Web Export"
                                       FontFamily="{DynamicResource MwSerif}" FontSize="22" FontStyle="Italic"
                                       Foreground="{DynamicResource MwBone}" />
                            <TextBlock Text="resize + convert + compress for hosting"
                                       FontFamily="{DynamicResource MwMono}" FontSize="10"
                                       Foreground="{DynamicResource MwAsh}" TextWrapping="Wrap" />
                            <Border Height="1" Background="{DynamicResource MwIronDark}" Margin="0,8,0,0" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                <TextBlock Grid.Column="0" Text="6 stations"
                                           FontFamily="{DynamicResource MwMono}" FontSize="9"
                                           LetterSpacing="1.2" Foreground="{DynamicResource MwIronLite}" />
                                <TextBlock Grid.Column="1" Text="ignite ▸"
                                           FontFamily="{DynamicResource MwMono}" FontSize="9"
                                           LetterSpacing="1.2" Foreground="{DynamicResource MwMolten}" />
                            </Grid>
                        </StackPanel>
                    </Button>
                    <Button Classes="templateButton" Margin="8"
                            Tag="bulk-image-compress"
                            Click="OnTemplateButtonClick"
                            Width="220">
                        <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Left">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="TPL.04"
                                           FontFamily="{DynamicResource MwMono}" FontSize="9"
                                           LetterSpacing="2.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MwMoltenHi}" />
                                <Rectangle Grid.Column="1" Width="6" Height="6" Fill="{DynamicResource MwCyan}" />
                            </Grid>
                            <TextBlock Text="Compress"
                                       FontFamily="{DynamicResource MwSerif}" FontSize="22" FontStyle="Italic"
                                       Foreground="{DynamicResource MwBone}" />
                            <TextBlock Text="reduce quality to target file-size budget"
                                       FontFamily="{DynamicResource MwMono}" FontSize="10"
                                       Foreground="{DynamicResource MwAsh}" TextWrapping="Wrap" />
                            <Border Height="1" Background="{DynamicResource MwIronDark}" Margin="0,8,0,0" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                <TextBlock Grid.Column="0" Text="3 stations"
                                           FontFamily="{DynamicResource MwMono}" FontSize="9"
                                           LetterSpacing="1.2" Foreground="{DynamicResource MwIronLite}" />
                                <TextBlock Grid.Column="1" Text="ignite ▸"
                                           FontFamily="{DynamicResource MwMono}" FontSize="9"
                                           LetterSpacing="1.2" Foreground="{DynamicResource MwMolten}" />
                            </Grid>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- Keyboard hints -->
                <StackPanel Orientation="Horizontal" Spacing="22" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="#14FFFFFF" BorderBrush="{DynamicResource MwIronDark}" BorderThickness="1" Padding="5,2">
                            <TextBlock Text="Ctrl+N" FontFamily="{DynamicResource MwMono}" FontSize="9" Foreground="{DynamicResource MwCyan}" />
                        </Border>
                        <TextBlock Text="new" FontFamily="{DynamicResource MwMono}" FontSize="9" LetterSpacing="1.4"
                                   Foreground="{DynamicResource MwFaint}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="#14FFFFFF" BorderBrush="{DynamicResource MwIronDark}" BorderThickness="1" Padding="5,2">
                            <TextBlock Text="Ctrl+O" FontFamily="{DynamicResource MwMono}" FontSize="9" Foreground="{DynamicResource MwCyan}" />
                        </Border>
                        <TextBlock Text="open" FontFamily="{DynamicResource MwMono}" FontSize="9" LetterSpacing="1.4"
                                   Foreground="{DynamicResource MwFaint}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="#14FFFFFF" BorderBrush="{DynamicResource MwIronDark}" BorderThickness="1" Padding="5,2">
                            <TextBlock Text="F1" FontFamily="{DynamicResource MwMono}" FontSize="9" Foreground="{DynamicResource MwCyan}" />
                        </Border>
                        <TextBlock Text="keys" FontFamily="{DynamicResource MwMono}" FontSize="9" LetterSpacing="1.4"
                                   Foreground="{DynamicResource MwFaint}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
