<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FlowForge.UI.ViewModels"
             xmlns:nodify="using:Nodify.Avalonia"
             xmlns:nodifyConn="using:Nodify.Avalonia.Connections"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="FlowForge.UI.Views.CanvasView"
             x:DataType="vm:EditorViewModel">

    <Grid>
        <!-- ═══ Canvas backdrop: forge ambience + cyberpunk grid ═══ -->
        <!-- Base gradient wash (ember-orange at bottom, cyan/mag accents) -->
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="0.5,1.1" GradientOrigin="0.5,1.1" RadiusX="0.9" RadiusY="0.5">
                    <GradientStop Offset="0" Color="#38FF5014" />
                    <GradientStop Offset="0.6" Color="Transparent" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="0.15,0.3" GradientOrigin="0.15,0.3" RadiusX="0.5" RadiusY="0.4">
                    <GradientStop Offset="0" Color="#152EF0FF" />
                    <GradientStop Offset="0.7" Color="Transparent" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="0.85,0.7" GradientOrigin="0.85,0.7" RadiusX="0.5" RadiusY="0.4">
                    <GradientStop Offset="0" Color="#10FF2E88" />
                    <GradientStop Offset="0.7" Color="Transparent" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <!-- Linear base tint behind it all -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#04020a" />
                    <GradientStop Offset="0.5" Color="#08060a" />
                    <GradientStop Offset="1" Color="#0f0a08" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <nodify:NodifyEditor x:Name="Editor"
                             ItemsSource="{Binding Nodes}"
                             Connections="{Binding Connections}"
                             PendingConnection="{Binding PendingConnection}"
                             ItemsDragStartedCommand="{Binding ItemsDragStartedCommand}"
                             ItemsDragCompletedCommand="{Binding ItemsDragCompletedCommand}"
                             Background="Transparent"
                             GridCellSize="40"
                             DragDrop.AllowDrop="True">

            <nodify:NodifyEditor.Styles>
                <Style Selector="nodify|ItemContainer" x:DataType="vm:PipelineNodeViewModel">
                    <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="0" />
                </Style>
                <Style Selector="nodify|ItemContainer:selected">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </nodify:NodifyEditor.Styles>

            <nodify:NodifyEditor.ItemTemplate>
                <DataTemplate x:DataType="vm:PipelineNodeViewModel">
                    <!-- ═══ Molten Works cast-iron station ═══ -->
                    <Grid Width="200" Height="130">

                        <!-- Iron body (200x130, rounded 3px, iron gradient) -->
                        <Border CornerRadius="3"
                                Background="{DynamicResource MwIronBody}"
                                BorderBrush="#050303"
                                BorderThickness="1"
                                BoxShadow="0 6 16 0 #B3000000">
                            <!-- Inset highlight on top + subtle bottom shadow -->
                            <Border CornerRadius="3"
                                    BorderThickness="0,1,0,1"
                                    ClipToBounds="True">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                        <GradientStop Offset="0" Color="#1EFFC896" />
                                        <GradientStop Offset="0.02" Color="Transparent" />
                                        <GradientStop Offset="0.98" Color="Transparent" />
                                        <GradientStop Offset="1" Color="#B3000000" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                        </Border>

                        <!-- Rivets at 4 corners (6px, inset 7px) -->
                        <Ellipse Width="6" Height="6"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Margin="7,7,0,0">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.3,0.3" GradientOrigin="0.3,0.3" RadiusX="0.7" RadiusY="0.7">
                                    <GradientStop Offset="0" Color="#8a7868" />
                                    <GradientStop Offset="0.75" Color="#2a1a12" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="6" Height="6"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,7,7,0">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.3,0.3" GradientOrigin="0.3,0.3" RadiusX="0.7" RadiusY="0.7">
                                    <GradientStop Offset="0" Color="#8a7868" />
                                    <GradientStop Offset="0.75" Color="#2a1a12" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="6" Height="6"
                                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                 Margin="7,0,0,7">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.3,0.3" GradientOrigin="0.3,0.3" RadiusX="0.7" RadiusY="0.7">
                                    <GradientStop Offset="0" Color="#8a7868" />
                                    <GradientStop Offset="0.75" Color="#2a1a12" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="6" Height="6"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,7,7">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.3,0.3" GradientOrigin="0.3,0.3" RadiusX="0.7" RadiusY="0.7">
                                    <GradientStop Offset="0" Color="#8a7868" />
                                    <GradientStop Offset="0.75" Color="#2a1a12" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Top code strip: code (left) + LIVE/IDLE pill (right) -->
                        <Grid Margin="12,6,12,0"
                              VerticalAlignment="Top"
                              Height="18"
                              ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding MwCode}"
                                       FontFamily="{DynamicResource MwMono}"
                                       FontSize="8" FontWeight="SemiBold"
                                       LetterSpacing="1.6"
                                       Foreground="{Binding MwNeonBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center">
                                <Ellipse Width="5" Height="5"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding IsRunning}"
                                         Fill="{Binding MwNeonBrush}" />
                                <Ellipse Width="5" Height="5"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding !IsRunning}"
                                         Fill="{DynamicResource MwFaint}" />
                                <TextBlock Text="LIVE"
                                           IsVisible="{Binding IsRunning}"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="8"
                                           LetterSpacing="1.6"
                                           Foreground="{Binding MwNeonBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="IDLE"
                                           IsVisible="{Binding !IsRunning}"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="8"
                                           LetterSpacing="1.6"
                                           Foreground="{DynamicResource MwFaint}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Main body: icon well + text column -->
                        <Grid Margin="14,28,38,16"
                              ColumnDefinitions="54,12,*">
                            <!-- Icon well -->
                            <Border Grid.Column="0"
                                    Width="54" Height="54"
                                    CornerRadius="3"
                                    BorderThickness="1"
                                    BorderBrush="#050303"
                                    VerticalAlignment="Top">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.3,0.2" GradientOrigin="0.3,0.2" RadiusX="0.9" RadiusY="0.9">
                                        <GradientStop Offset="0" Color="#3a1808" />
                                        <GradientStop Offset="1" Color="#0a0503" />
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Viewbox Width="30" Height="30">
                                    <Path Data="{Binding MwIconGeometry}"
                                          Stroke="{Binding MwNeonBrush}"
                                          StrokeThickness="1.7"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Width="40" Height="40" />
                                </Viewbox>
                            </Border>

                            <!-- Text column -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Vertical"
                                        Spacing="3"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           FontFamily="{DynamicResource MwSerif}"
                                           FontSize="18"
                                           FontStyle="Italic"
                                           LineHeight="18"
                                           Foreground="{DynamicResource MwBone}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding MwSub}"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="9"
                                           LetterSpacing="1"
                                           Foreground="{DynamicResource MwIronLite}"
                                           TextTrimming="CharacterEllipsis" />
                                <!-- Config preview -->
                                <Border Padding="6,3"
                                        Background="{DynamicResource MwInkA45}"
                                        BorderThickness="2,0,0,0"
                                        BorderBrush="{Binding MwNeonBrush}"
                                        IsVisible="{Binding ConfigPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Margin="0,2,0,0">
                                    <TextBlock Text="{Binding ConfigPreview}"
                                               FontFamily="{DynamicResource MwMono}"
                                               FontSize="9.5"
                                               Foreground="{DynamicResource MwBone}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="95" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Right-side gauge strip: T / p / Δ -->
                        <StackPanel Orientation="Vertical"
                                    Spacing="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,30,4,12"
                                    Width="26">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="T"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="7"
                                           Foreground="{DynamicResource MwFaint}" />
                                <TextBlock Grid.Column="1" Text="86"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="7"
                                           Foreground="{DynamicResource MwIronLite}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="p"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="7"
                                           Foreground="{DynamicResource MwFaint}" />
                                <TextBlock Grid.Column="1" Text="72"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="7"
                                           Foreground="{DynamicResource MwIronLite}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Δ"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="7"
                                           Foreground="{DynamicResource MwFaint}" />
                                <TextBlock Grid.Column="1" Text="43"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="7"
                                           Foreground="{DynamicResource MwIronLite}" />
                            </Grid>
                        </StackPanel>

                        <!-- Input connectors (left edge) -->
                        <ItemsControl ItemsSource="{Binding Input}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="-8,0,0,0"
                                      IsHitTestVisible="True"
                                      ZIndex="5">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PipelineConnectorViewModel">
                                    <nodifyConn:Connector Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                          IsConnected="{Binding IsConnected}"
                                                          Width="12" Height="18"
                                                          Cursor="Hand">
                                        <nodifyConn:Connector.Template>
                                            <ControlTemplate>
                                                <Border Width="12" Height="18"
                                                        CornerRadius="3,0,0,3"
                                                        BorderBrush="#050303"
                                                        BorderThickness="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                            <GradientStop Offset="0" Color="#050303" />
                                                            <GradientStop Offset="1" Color="#4a4a58" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Ellipse Width="6" Height="6"
                                                             HorizontalAlignment="Left"
                                                             VerticalAlignment="Center"
                                                             Margin="3,0,0,0"
                                                             Fill="{DynamicResource MwChromeDk}" />
                                                </Border>
                                            </ControlTemplate>
                                        </nodifyConn:Connector.Template>
                                    </nodifyConn:Connector>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Output connectors (right edge) -->
                        <ItemsControl ItemsSource="{Binding Output}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,-8,0"
                                      IsHitTestVisible="True"
                                      ZIndex="5">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PipelineConnectorViewModel">
                                    <nodifyConn:Connector Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                          IsConnected="{Binding IsConnected}"
                                                          Width="12" Height="18"
                                                          Cursor="Hand">
                                        <nodifyConn:Connector.Template>
                                            <ControlTemplate>
                                                <Border Width="12" Height="18"
                                                        CornerRadius="0,3,3,0"
                                                        BorderBrush="#050303"
                                                        BorderThickness="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                            <GradientStop Offset="0" Color="#4a4a58" />
                                                            <GradientStop Offset="1" Color="#050303" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Ellipse Width="6" Height="6"
                                                             HorizontalAlignment="Right"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,3,0"
                                                             Fill="{DynamicResource MwChromeDk}" />
                                                </Border>
                                            </ControlTemplate>
                                        </nodifyConn:Connector.Template>
                                    </nodifyConn:Connector>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Selection glow: outer cyan drop-shadow when selected -->
                        <Border IsHitTestVisible="False"
                                CornerRadius="3"
                                IsVisible="{Binding IsSelected}"
                                BoxShadow="0 0 16 0 #992EF0FF" />
                    </Grid>
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>

            <nodify:NodifyEditor.ConnectionTemplate>
                <DataTemplate x:DataType="vm:PipelineConnectionViewModel">
                    <!-- Chrome pipe: 4-layer stroke (shadow → chrome outer → core → inner channel) -->
                    <Grid>
                        <nodifyConn:Connection Source="{Binding Source.Anchor}"
                                               Target="{Binding Target.Anchor}"
                                               Stroke="#D9000000"
                                               StrokeThickness="14" />
                        <nodifyConn:Connection Source="{Binding Source.Anchor}"
                                               Target="{Binding Target.Anchor}"
                                               Stroke="{DynamicResource MwChromeDk}"
                                               StrokeThickness="11" />
                        <nodifyConn:Connection Source="{Binding Source.Anchor}"
                                               Target="{Binding Target.Anchor}"
                                               Stroke="{DynamicResource MwChrome}"
                                               StrokeThickness="8" />
                        <nodifyConn:Connection Source="{Binding Source.Anchor}"
                                               Target="{Binding Target.Anchor}"
                                               Stroke="#050303"
                                               StrokeThickness="5" />
                        <nodifyConn:Connection Source="{Binding Source.Anchor}"
                                               Target="{Binding Target.Anchor}"
                                               Stroke="{DynamicResource MwChromeHi}"
                                               StrokeThickness="0.8"
                                               Opacity="0.7" />
                    </Grid>
                </DataTemplate>
            </nodify:NodifyEditor.ConnectionTemplate>

            <nodify:NodifyEditor.PendingConnectionTemplate>
                <DataTemplate x:DataType="vm:PipelinePendingConnectionViewModel">
                    <nodifyConn:PendingConnection IsVisible="{Binding IsVisible}"
                                                  StartedCommand="{Binding StartCommand}"
                                                  CompletedCommand="{Binding FinishCommand}"
                                                  EnablePreview="True"
                                                  EnableSnapping="True"
                                                  Stroke="{DynamicResource MwMolten}"
                                                  StrokeThickness="3"
                                                  PreviewTarget="{Binding PreviewTarget, Mode=OneWayToSource}" />
                </DataTemplate>
            </nodify:NodifyEditor.PendingConnectionTemplate>

        </nodify:NodifyEditor>

        <!-- HUD corner brackets (magenta, 18x18, .5 opacity) -->
        <Border IsHitTestVisible="False"
                Width="18" Height="18"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="12,12,0,0"
                BorderBrush="{DynamicResource MwMag}"
                BorderThickness="1,1,0,0"
                Opacity="0.5" />
        <Border IsHitTestVisible="False"
                Width="18" Height="18"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,12,12,0"
                BorderBrush="{DynamicResource MwMag}"
                BorderThickness="0,1,1,0"
                Opacity="0.5" />
        <Border IsHitTestVisible="False"
                Width="18" Height="18"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="12,0,0,12"
                BorderBrush="{DynamicResource MwMag}"
                BorderThickness="1,0,0,1"
                Opacity="0.5" />
        <Border IsHitTestVisible="False"
                Width="18" Height="18"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,12,12"
                BorderBrush="{DynamicResource MwMag}"
                BorderThickness="0,0,1,1"
                Opacity="0.5" />

        <!-- Hint caption top-left -->
        <TextBlock IsHitTestVisible="False"
                   Text="drag stations · click to select · ▶ ignite to run"
                   FontFamily="{DynamicResource MwMono}"
                   FontSize="10"
                   LetterSpacing="1"
                   Foreground="{DynamicResource MwFaint}"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="40,14,0,0" />

        <!-- System HUD bottom-right -->
        <Border IsHitTestVisible="False"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,38,14"
                Padding="10,8"
                Background="{DynamicResource MwInkA85}"
                BorderBrush="{DynamicResource MwIronDark}"
                BorderThickness="1">
            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBlock Text="// SYSTEM"
                           FontFamily="{DynamicResource MwMono}"
                           FontSize="8"
                           LetterSpacing="1.6"
                           Foreground="{DynamicResource MwFaint}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="lat:" FontFamily="{DynamicResource MwMono}" FontSize="10" Foreground="{DynamicResource MwFaint}" />
                        <TextBlock Text="6.2ms" FontFamily="{DynamicResource MwMono}" FontSize="10" Foreground="{DynamicResource MwCyan}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="mem:" FontFamily="{DynamicResource MwMono}" FontSize="10" Foreground="{DynamicResource MwFaint}" />
                        <TextBlock Text="142MB" FontFamily="{DynamicResource MwMono}" FontSize="10" Foreground="{DynamicResource MwLime}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="err:" FontFamily="{DynamicResource MwMono}" FontSize="10" Foreground="{DynamicResource MwFaint}" />
                        <TextBlock Text="0" FontFamily="{DynamicResource MwMono}" FontSize="10" Foreground="{DynamicResource MwLime}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ Empty state: Mw "Build your pipeline from raw ore" ═══ -->
        <Border IsVisible="{Binding !HasNodes}"
                IsHitTestVisible="True"
                DragDrop.AllowDrop="True">
            <Border.Background>
                <SolidColorBrush Color="#08060a" Opacity="0.7" />
            </Border.Background>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="18"
                        MaxWidth="920">

                <!-- Eyebrow -->
                <TextBlock Text="// BOOT.SEQ · READY"
                           FontFamily="{DynamicResource MwMono}"
                           FontSize="10"
                           LetterSpacing="4"
                           Foreground="{DynamicResource MwCyan}"
                           HorizontalAlignment="Center" />

                <!-- Hero headline -->
                <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <TextBlock Text="Build your pipeline"
                               FontFamily="{DynamicResource MwSerifRegular}"
                               FontSize="62"
                               FontWeight="Normal"
                               LineHeight="62"
                               Foreground="{DynamicResource MwBone}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="from raw ore."
                               FontFamily="{DynamicResource MwSerif}"
                               FontSize="62"
                               FontStyle="Italic"
                               FontWeight="Light"
                               LineHeight="62"
                               Foreground="{DynamicResource MwMolten}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Subhead mono -->
                <TextBlock Text="> start from a template below, or drag operations from the library onto the canvas."
                           FontFamily="{DynamicResource MwMono}"
                           FontSize="12"
                           LineHeight="18"
                           Foreground="{DynamicResource MwAsh}"
                           HorizontalAlignment="Center" />

                <!-- Template cards: 4 cast-iron buttons -->
                <UniformGrid Columns="4" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button Classes="templateButton" Margin="8"
                            Tag="photo-import-by-date"
                            Click="OnTemplateButtonClick"
                            Width="220">
                        <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Left">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="TPL.01"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="9"
                                           LetterSpacing="2.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MwMoltenHi}" />
                                <Rectangle Grid.Column="1" Width="6" Height="6" Fill="{DynamicResource MwCyan}" />
                            </Grid>
                            <TextBlock Text="Photo Import"
                                       FontFamily="{DynamicResource MwSerif}"
                                       FontSize="22"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource MwBone}" />
                            <TextBlock Text="camera SD → dated folders → web sizes"
                                       FontFamily="{DynamicResource MwMono}"
                                       FontSize="10"
                                       Foreground="{DynamicResource MwAsh}"
                                       TextWrapping="Wrap" />
                            <Border Height="1"
                                    Background="{DynamicResource MwIronDark}"
                                    Margin="0,8,0,0" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                <TextBlock Grid.Column="0"
                                           Text="5 stations"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="9"
                                           LetterSpacing="1.2"
                                           Foreground="{DynamicResource MwIronLite}" />
                                <TextBlock Grid.Column="1"
                                           Text="ignite ▸"
                                           FontFamily="{DynamicResource MwMono}"
                                           FontSize="9"
                                           LetterSpacing="1.2"
                                           Foreground="{DynamicResource MwMolten}" />
                            </Grid>
                        </StackPanel>
                    </Button>
                    <Button Classes="templateButton" Margin="8"
                            Tag="batch-sequential-rename"
                            Click="OnTemplateButtonClick"
                            Width="220">
                        <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Left">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="TPL.02"
                                           FontFamily="{DynamicResource MwMono}" FontSize="9"
                                           LetterSpacing="2.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MwMoltenHi}" />
                                <Rectangle Grid.Column="1" Width="6" Height="6" Fill="{DynamicResource MwCyan}" />
                            </Grid>
                            <TextBlock Text="Batch Rename"
                                       FontFamily="{DynamicResource MwSerif}" FontSize="22" FontStyle="Italic"
                                       Foreground="{DynamicResource MwBone}" />
                            <TextBlock Text="sequential counter with date prefix"
                                       FontFamily="{DynamicResource MwMono}" FontSize="10"
                                       Foreground="{DynamicResource MwAsh}" TextWrapping="Wrap" />
                            <Border Height="1" Background="{DynamicResource MwIronDark}" Margin="0,8,0,0" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                <TextBlock Grid.Column="0" Text="3 stations"
                                           FontFamily="{DynamicResource MwMono}" FontSize="9"
                                           LetterSpacing="1.2" Foreground="{DynamicResource MwIronLite}" />
                                <TextBlock Grid.Column="1" Text="ignite ▸"
                                           FontFamily="{DynamicResource MwMono}" FontSize="9"
                                           LetterSpacing="1.2" Foreground="{DynamicResource MwMolten}" />
                            </Grid>
                        </StackPanel>
                    </Button>
                    <Button Classes="templateButton" Margin="8"
                            Tag="image-web-export"
                            Click="OnTemplateButtonClick"
                            Width="220">
                        <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Left">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="TPL.03"
                                           FontFamily="{DynamicResource MwMono}" FontSize="9"
                                           LetterSpacing="2.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MwMoltenHi}" />
                                <Rectangle Grid.Column="1" Width="6" Height="6" Fill="{DynamicResource MwCyan}" />
                            </Grid>
                            <TextBlock Text="Web Export"
                                       FontFamily="{DynamicResource MwSerif}" FontSize="22" FontStyle="Italic"
                                       Foreground="{DynamicResource MwBone}" />
                            <TextBlock Text="resize + convert + compress for hosting"
                                       FontFamily="{DynamicResource MwMono}" FontSize="10"
                                       Foreground="{DynamicResource MwAsh}" TextWrapping="Wrap" />
                            <Border Height="1" Background="{DynamicResource MwIronDark}" Margin="0,8,0,0" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                <TextBlock Grid.Column="0" Text="6 stations"
                                           FontFamily="{DynamicResource MwMono}" FontSize="9"
                                           LetterSpacing="1.2" Foreground="{DynamicResource MwIronLite}" />
                                <TextBlock Grid.Column="1" Text="ignite ▸"
                                           FontFamily="{DynamicResource MwMono}" FontSize="9"
                                           LetterSpacing="1.2" Foreground="{DynamicResource MwMolten}" />
                            </Grid>
                        </StackPanel>
                    </Button>
                    <Button Classes="templateButton" Margin="8"
                            Tag="bulk-image-compress"
                            Click="OnTemplateButtonClick"
                            Width="220">
                        <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Left">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="TPL.04"
                                           FontFamily="{DynamicResource MwMono}" FontSize="9"
                                           LetterSpacing="2.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MwMoltenHi}" />
                                <Rectangle Grid.Column="1" Width="6" Height="6" Fill="{DynamicResource MwCyan}" />
                            </Grid>
                            <TextBlock Text="Compress"
                                       FontFamily="{DynamicResource MwSerif}" FontSize="22" FontStyle="Italic"
                                       Foreground="{DynamicResource MwBone}" />
                            <TextBlock Text="reduce quality to target file-size budget"
                                       FontFamily="{DynamicResource MwMono}" FontSize="10"
                                       Foreground="{DynamicResource MwAsh}" TextWrapping="Wrap" />
                            <Border Height="1" Background="{DynamicResource MwIronDark}" Margin="0,8,0,0" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                <TextBlock Grid.Column="0" Text="3 stations"
                                           FontFamily="{DynamicResource MwMono}" FontSize="9"
                                           LetterSpacing="1.2" Foreground="{DynamicResource MwIronLite}" />
                                <TextBlock Grid.Column="1" Text="ignite ▸"
                                           FontFamily="{DynamicResource MwMono}" FontSize="9"
                                           LetterSpacing="1.2" Foreground="{DynamicResource MwMolten}" />
                            </Grid>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- Keyboard hints -->
                <StackPanel Orientation="Horizontal" Spacing="22" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="#14FFFFFF" BorderBrush="{DynamicResource MwIronDark}" BorderThickness="1" Padding="5,2">
                            <TextBlock Text="Ctrl+N" FontFamily="{DynamicResource MwMono}" FontSize="9" Foreground="{DynamicResource MwCyan}" />
                        </Border>
                        <TextBlock Text="new" FontFamily="{DynamicResource MwMono}" FontSize="9" LetterSpacing="1.4"
                                   Foreground="{DynamicResource MwFaint}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="#14FFFFFF" BorderBrush="{DynamicResource MwIronDark}" BorderThickness="1" Padding="5,2">
                            <TextBlock Text="Ctrl+O" FontFamily="{DynamicResource MwMono}" FontSize="9" Foreground="{DynamicResource MwCyan}" />
                        </Border>
                        <TextBlock Text="open" FontFamily="{DynamicResource MwMono}" FontSize="9" LetterSpacing="1.4"
                                   Foreground="{DynamicResource MwFaint}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="#14FFFFFF" BorderBrush="{DynamicResource MwIronDark}" BorderThickness="1" Padding="5,2">
                            <TextBlock Text="F1" FontFamily="{DynamicResource MwMono}" FontSize="9" Foreground="{DynamicResource MwCyan}" />
                        </Border>
                        <TextBlock Text="keys" FontFamily="{DynamicResource MwMono}" FontSize="9" LetterSpacing="1.4"
                                   Foreground="{DynamicResource MwFaint}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
